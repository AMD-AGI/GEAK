SCOPE
    The ``input_scale is not None`` branch is untouched: there the caller already
    owns the scale and the layout is not ours to choose. Only the branch that
    quantises the activation itself changes, which is every FP8 linear in this
    model (qkv, o, gate_up, down -- 4 per layer, 40 layers).

#
# FULL-STACK RESULT (patches 1+2+3, interleaved A/B against the pristine stack, run last):
#   output throughput  1538.009 -> 1985.566 tok/s   +29.05%  (median of n=6 each,
#                      6/6 position-matched pairs positive, +28.91..+29.19%, arms disjoint)
#   gsm8k 5-shot       0.9454 -> 0.9454, identical on all 1319 problems
#   arms: results/stackab_{A,B}{1,2}_r{1,2,3}_*   gate: eval_results/stackab_B2_20260820_120659
#   driver: analysis/ab/run_ab_stack.sh + analysis/ab/stack_{A,B}.sh
--- a/python/sglang/srt/layers/quantization/fp8_utils.py
+++ b/python/sglang/srt/layers/quantization/fp8_utils.py
@@ -1048,13 +1048,22 @@
             x_scale = torch.as_strided(x_scale, x_scale.shape, (1, x_scale.shape[0]))
     else:
         materialize_bpreshuffle_scale = _use_aiter_bpreshuffle_gfx95 and not use_triton
+        # Ask the quant kernel for the layout the GEMM wants instead of writing
+        # row-major and then paying a transposing copy for it.
+        # ``transpose_scale`` maps to ``shuffle_scale`` in
+        # ``dynamic_per_group_scaled_quant``, which emits the scale bytes already
+        # in the column-major [G, M] arrangement ``bpreshuffle`` consumes; all
+        # that is left is to index them as [M, G], which is a stride
+        # reinterpretation and not a kernel launch. Byte-for-byte identical to
+        # ``materialize_bpreshuffle_fp8_scale`` on this model's decode shapes
+        # ((64, 5120) and (64, 17408)); the quantized tensor itself is unchanged.
         q_input, x_scale = aiter_per1x128_quant(
             input_2d,
             quant_dtype=aiter.dtypes.fp8,
-            transpose_scale=False,
+            transpose_scale=materialize_bpreshuffle_scale,
         )
         if materialize_bpreshuffle_scale:
-            x_scale = materialize_bpreshuffle_fp8_scale(x_scale)
+            x_scale = view_aiter_fused_rms_transposed_fp8_scale(x_scale)
 
     if use_triton:
         gemm_a8w8_blockscale_op = triton_gemm_a8w8_blockscale

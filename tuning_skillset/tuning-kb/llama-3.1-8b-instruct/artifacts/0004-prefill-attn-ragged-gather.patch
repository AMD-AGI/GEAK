# Ragged (v3 ASM) prefill attention for bf16 head_dim-128, with a KV gather
#
# Base
#   /sgl-workspace/sglang/python/sglang/srt/layers/attention/aiter_backend.py
#   SGLang 0.5.17, installed as a plain package -- no git metadata, so the base is the pristine
#   copy analysis/base/aiter_backend.py.orig, taken with `cp` before the first edit
#   (sha256 45b09e64f84d..., see FINDINGS.md "Pristine copies").
#   The candidate is generated from that copy by analysis/make_ragged_patch.py, not hand-edited.
#
# Apply
#   cd / && patch -p0 < patches/0004-prefill-attn-ragged-gather.patch
#   # or, reversibly, as the A/B campaign does it:
#   python3 analysis/deploy_ragged_prefill.py apply|revert
#   The server must be restarted afterwards.
#
# What it does
#   SGLang's aiter backend serves Llama prefill with mha_batch_prefill_func (ck_tile), which walks
#   the paged KV pool through a page table inside the softmax loop. aiter also ships a hand-written
#   gfx950 v3 ASM kernel for this exact shape (fwd_hd128_bf16_causal_group.co) behind
#   flash_attn_varlen_func, but it has no paged variant at page_size 1 -- it rejects any block table
#   whose page size is not a multiple of 128. This patch materialises the batch's KV span
#   contiguously with two index_selects and calls the ASM kernel. The gather costs ~100 MB of
#   traffic per layer and the kernel wins far more than that back.
#
#   The gather is what makes it work at all. The obvious cheaper gate -- "use the ragged kernel only
#   when no sequence has a prefix", which is what the pre-existing fp8/head_dim-256 branch just above
#   does -- fires on zero of the benchmark's prefill batches: the prompts are 8192 tokens, the
#   tokenizer prepends BOS, 2*8193 exceeds the 16384-token chunked-prefill budget, and from the
#   second batch onward every batch carries a chunk continuation. A batch-gated version of this
#   change measured +0.03% end to end (FINDINGS.md § 3).
#
# Measurement (bench/, 192 prompts @ concurrency 64, ISL 8192 / OSL 1024, TP=1)
#   local baseline   2636.160 tok/s   (results/r2_base_probe1_20260820_151927, fresh server, run #1)
#   reference figure 2588.104 tok/s   (BASELINE.md; do not mix rigs)
#   patched          2724.708 tok/s   mean of 6 restart-paired rounds
#   gain             +3.185% +/- 0.916% (sd of the 6 paired deltas), all 6 positive,
#                    min +1.524%, max +4.332%; restart floor is 0.14%
#   mean TTFT        3986.8 -> 3571.7 ms  (-10.4%)
#   mean TPOT        20.353 -> 20.011 ms  (-1.7%)
#   campaign         DEPLOY=analysis/deploy_ragged_prefill.py ROUNDS=6 PREFIX=r2rgv2 \
#                      analysis/ab_campaign.sh
#                    results/r2rgv2_{base,cand}_r{1..6}_*, log /tmp/r2_ab_rgv2.log
#
#   Isolated race at the shape the benchmark actually produces (analysis/bench_prefill_attn2.py:
#   3 seqs, q 2/8193/8189, kv 8193/8193/8189, production-sized pool, graph-captured, interleaved,
#   arm-position control at -0.08%):
#     paged (mha_batch_prefill_func)  1724.25 us
#     gather + v3 ASM varlen          1082.51 us   +37.22%  (gather included in the timed region)
#   Numerics vs the paged arm: max_rel_err 6.443e-04, cos 0.99999976.
#
#   Scheduler-reported prefill throughput during the benchmark itself
#   (analysis/prefill_stats.py over the per-arm server logs kept by analysis/ab_campaign.sh):
#     base  70531 - 70687 tok/s   (232.0 ms/batch, 6 restarts, 0.22% spread)
#     cand  78594 - 79507 tok/s   (207.3 ms/batch, 6 restarts, 1.16% spread)
#     mean  70616 -> 79019 tok/s  = +11.90% on the phase the patch touches, and a clean
#           12-of-12 separation that doubles as proof no arm was ever half-applied
#
# Accuracy
#   gsm8k 5-shot strict-match 0.8491 +/- 0.0099 (flexible-extract 0.8499)
#     eval_results/r2_ragged_gather_20260820_170637
#   round-2 baseline          0.8431 +/- 0.010   (eval_results/r2_baseline_20260820_152801)
#   gate                      >= 0.8213 -- passes; the +0.006 is inside one standard error,
#                             i.e. no measurable accuracy change in either direction.
#
# Independent of the three patches in rejected/; touches no GEMM config table.
--- /sgl-workspace/sglang/python/sglang/srt/layers/attention/aiter_backend.py
+++ /sgl-workspace/sglang/python/sglang/srt/layers/attention/aiter_backend.py
@@ -723,6 +723,24 @@
             )
         return self._kv_indices_scratch[:required_tokens]
 
+    def _ragged_kv_scratch(self, n_tokens, layer, dtype, device):
+        """Contiguous K/V staging buffers for the gather+ASM prefill path."""
+        need = n_tokens * layer.tp_k_head_num * layer.qk_head_dim
+        cur = getattr(self, "_ragged_kv_buf", None)
+        if (
+            cur is None
+            or cur[0].device != device
+            or cur[0].dtype != dtype
+            or cur[0].numel() < need
+        ):
+            self._ragged_kv_buf = (
+                torch.empty(need, dtype=dtype, device=device),
+                torch.empty(need, dtype=dtype, device=device),
+            )
+        kb, vb = self._ragged_kv_buf
+        shape = (n_tokens, layer.tp_k_head_num, layer.qk_head_dim)
+        return kb[:need].view(shape), vb[:need].view(shape)
+
     def _set_uniform_qo_indptr(
         self, bs: int, tokens_per_req: int, device: torch.device
     ) -> torch.Tensor:
@@ -2374,6 +2392,71 @@
                     o = o.to(self.input_dtype)
                 return o.view(-1, layer.tp_q_head_num * layer.head_dim)
 
+            if (
+                is_gfx95_supported()
+                and forward_batch.forward_mode.is_extend()
+                and window_size == (-1, -1)
+                and sinks is None
+                and self.logits_soft_cap == 0.0
+                and layer.qk_head_dim == 128
+                and layer.v_head_dim == 128
+                and self.kv_cache_dtype != fp8_dtype
+                and not self.kv_cache_is_vectorized_5d
+                and q.dtype == torch.bfloat16
+                and self.forward_metadata.kv_indices is not None
+                and self.forward_metadata.max_kv_len is not None
+            ):
+                # bf16 head_dim-128 twin of the fp8/head_dim-256 branch above, generalised to
+                # batches that carry a prefix.
+                #
+                # The paged kernel (mha_batch_prefill_func, ck_tile) resolves the page table
+                # *inside* the softmax loop; the v3 ASM kernel behind flash_attn_varlen_func
+                # (hsa/gfx950/fmha_v3_fwd/fwd_hd128_bf16_causal_group.co) has no paged variant at
+                # page_size 1 -- it rejects any block table whose page size is not a multiple of
+                # 128 -- so feeding it means materialising the KV span contiguously first.
+                # Two index_selects move ~100 MB per layer at this shape and the ASM kernel wins
+                # far more than that back: raced at the shape the benchmark actually produces
+                # (3 seqs, q 2/8193/8189, kv 8193/8193/8189) the gather+ASM pair is 37.22% faster
+                # than the paged call *including* the gather, max_rel_err 6.4e-04.
+                #
+                # Gating on the prefix being empty instead -- the obvious cheaper thing, and what
+                # the fp8 branch above does -- is worthless here: the served prompts are 8192
+                # tokens, the tokenizer prepends BOS, and 2*8193 exceeds the 16384-token
+                # chunked-prefill budget, so from the second batch onward every prefill batch
+                # contains one chunk continuation and a no-prefix gate never fires.
+                #
+                # causal=True with cu_seqlens_k != cu_seqlens_q is bottom-right aligned, which is
+                # the correct mask for a chunk continuation.
+                k_cache, v_cache = self.token_to_kv_pool.get_kv_buffer(layer.layer_id)
+                idx = self.forward_metadata.kv_indices
+                kb = k_cache.view(-1, layer.tp_k_head_num, layer.qk_head_dim)
+                vb = v_cache.view(-1, layer.tp_v_head_num, layer.v_head_dim)
+                kg, vg = self._ragged_kv_scratch(
+                    idx.shape[0], layer, kb.dtype, kb.device
+                )
+                torch.index_select(kb, 0, idx, out=kg)
+                torch.index_select(vb, 0, idx, out=vg)
+
+                ragged_kwargs = {}
+                attn_out = getattr(forward_batch, "_attn_output", None)
+                if attn_out is not None:
+                    ragged_kwargs["out"] = attn_out.view(
+                        -1, layer.tp_q_head_num, layer.v_head_dim
+                    )
+                o = flash_attn_varlen_func(
+                    q.contiguous().view(-1, layer.tp_q_head_num, layer.qk_head_dim),
+                    kg,
+                    vg,
+                    self.qo_indptr[:bs0],
+                    self.forward_metadata.kv_indptr[:bs0],
+                    self.forward_metadata.max_q_len,
+                    self.forward_metadata.max_kv_len,
+                    softmax_scale=layer.scaling,
+                    causal=True,
+                    **ragged_kwargs,
+                )
+                return o.view(-1, layer.tp_q_head_num * layer.v_head_dim)
+
             if self.kv_cache_is_vectorized_5d:

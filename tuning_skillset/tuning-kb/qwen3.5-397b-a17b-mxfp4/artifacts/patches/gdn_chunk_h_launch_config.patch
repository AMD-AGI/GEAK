+GDN_CHUNK_H_BV = os.getenv("SGLANG_GDN_CHUNK_H_BV")
+GDN_CHUNK_H_NUM_WARPS = os.getenv("SGLANG_GDN_CHUNK_H_NUM_WARPS")
+GDN_CHUNK_H_NUM_STAGES = os.getenv("SGLANG_GDN_CHUNK_H_NUM_STAGES")
+
+
+@lru_cache(maxsize=1)
+def _num_cus() -> int:
+    return torch.cuda.get_device_properties(
+        torch.cuda.current_device()
+    ).multi_processor_count
+
+
+def gdn_chunk_h_launch_config(V: int, N: int, H: int) -> Tuple[int, int, int]:
+    """Pick (BV, num_warps, num_stages) for this launch. Returns the shipped
+    32/4/2 unless a smaller tile is known to win at this grid size.
+
+    The kernel's grid is (cdiv(V, BV), N * H), so BV alone decides how much of
+    the device gets work. On a 256-CU MI355X with V=128, H=16 (Qwen3.5-397B-A17B
+    at TP=4) and the 16384-token chunked-prefill limit, N is 1 or 2, so the
+    shipped BV=32 launches 64 or 128 workgroups and leaves half to three
+    quarters of the device idle. Halving BV doubles the grid; the cost is that
+    each i_v workgroup re-reads all of k, so once the device is already
+    oversubscribed the duplicated traffic outweighs the parallelism and BV=32
+    wins again. Deeper pipelining pays for itself only in the same undersubscribed
+    regime.
+
+    Measured on MI355X / ROCm 7.2 at V=K=128, H=16, Hg=4, T=8192 per sequence
+    (analysis/gdn/bench_chunk_h.py in the tuning bundle; us for the whole kernel):
+
+        N   grid(BV=16)   shipped 32/4/2   this function     speedup
+        1       128           369.06        272.88 (16/4/3)   1.352x
+        2       256           507.41        419.59 (16/4/3)   1.209x
+        3       384           538.40        478.44 (16/4/2)   1.125x
+        4       512           563.98        500.94 (16/4/2)   1.126x
+        8      1024           742.30        742.30 (shipped)  1.000x
+
+    At N=8 the best config found was 32/2/2 at 716.81 us; this function leaves
+    that 3.4% alone rather than widen the rule on one point. BV never changes a
+    reduction order -- V is tiled, not reduced -- so output is unaffected.
+    """
+    if GDN_CHUNK_H_BV or GDN_CHUNK_H_NUM_WARPS or GDN_CHUNK_H_NUM_STAGES:
+        # An explicit env override wins over the heuristic, for A/B-ing a tile
+        # on a model or a part this was not measured on.
+        return (
+            int(GDN_CHUNK_H_BV or 32),
+            int(GDN_CHUNK_H_NUM_WARPS or 4),
+            int(GDN_CHUNK_H_NUM_STAGES or 2),
         )
-    ],
-    key=["H", "K", "V", "BT", "USE_GK", "NT_BUCKET"],
-    **autotune_cache_kwargs,
-)
+    small_tile_grid = triton.cdiv(V, 16) * N * H
+    if small_tile_grid > 2 * _num_cus():
+        return 32, 4, 2
+    return 16, 4, 3 if small_tile_grid <= _num_cus() else 2
+
+
+# No @triton.autotune. The kernel writes ht (final state) back into
+# initial_state in-place, so triton's autotune benchmark phase -- which invokes
+# the kernel many times for timing -- corrupts the cache pool and produces
+# silently wrong output on the first user request. Restoring via
+# `restore_value=["initial_state"]` works for unit tests but OOMs on
+# production-scale models (e.g. Kimi-Linear-48B at default mem_fraction)
+# because cloning the cache pool for each benchmark exceeds available memory.
+# The launch config is therefore chosen analytically, by
+# gdn_chunk_h_launch_config() above, from the grid the caller is about to use --
+# which the autotune key (H, K, V, BT, USE_GK, NT_BUCKET) could not express
+# anyway, because it does not contain N.
 @triton.jit(do_not_specialize=["T"])

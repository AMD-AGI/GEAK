# Patch: pick the topk-softmax load width from the row count (512-expert routing)
#
# Base:   aiter @ d9e5ef7ce08ee7045d583aed768cff41aa9210fe (/sgl-workspace/aiter)
# Apply:  cd /sgl-workspace/aiter && git apply /path/to/topk_softmax_ldg_width.patch
#         then rebuild the module the kernel lives in:
#           python3 -c "import inspect; from aiter.jit.core import build_module, get_args_of_build; \
#             d=get_args_of_build('module_moe_asm'); s=inspect.signature(build_module); \
#             build_module(md_name='module_moe_asm', **{k:v for k,v in d.items() \
#             if k in s.parameters and k!='md_name'})"
#         and restart the server (the decode path is HIP-graph captured).
#
# What it is
#   topkGatingSoftmaxLauncherHelper sizes its per-thread load as
#   MAX_BYTES_PER_LDG = EXPERTS < 512 ? 32 : 64. This model routes over 512 experts with
#   bf16 logits, so it takes the 64-byte branch: VPT = 32 elements per thread and
#   THREADS_PER_ROW = 512/32 = 16, i.e. a quarter of the 64-lane wavefront works on a row.
#   The top-k loop then rescans all 32 registers on each of its k-1 iterations, which at
#   k=10 is 288 serialised compares standing between the row's load and its result.
#
#   That chain, not bandwidth and not occupancy, is what the kernel costs at decode. Measured
#   standalone on one MI355X (analysis/topk/prof_topk.py, device time from torch.profiler, not
#   wall time -- a cuda-event loop around the python wrapper reports a flat ~19 us at every M
#   and is measuring dispatch):
#
#       rows     stock     patched
#         64   10.57 us     8.40 us   (-20.5%)   <- decode batch
#        128   10.76        8.35
#        256   10.96        8.51
#        512   10.67        8.61
#       8192   13.13       13.21                 <- prefill, unchanged by design
#      16384   20.22       20.13
#
#   Stock being flat from 64 to 512 rows is the evidence: 8 workgroups and 64 workgroups cost
#   the same, so more parallelism was never the missing thing. Sizing the load so
#   THREADS_PER_ROW reaches the full wavefront cuts the serial chain 4x and is worth 2.2 us.
#
#   It is not free at large M -- the narrow form issues 4x the waves and loads 4x less per
#   instruction, and crosses back over the wide form near M ~ 2000 (M=8192: 20.1 us narrow vs
#   13.1 us wide). So the launcher picks between the two on num_rows. Decode batches are tens
#   of rows and prefill chunks are thousands; the threshold sits in the gap between them.
#
#   Output is bit-identical to stock: analysis/topk/check_topk.py dumps weights, indices and
#   token_expert_indices for M in {1,3,64,65,128,255,256,512,8192,16384} x
#   {bf16, fp16, fp32} and all 30 cases compare equal with torch.equal.
#
# Measured  (ISL 8192 / OSL 1024 / concurrency 64 / 192 prompts / TP=4; one server start per
#            arm, first benchmark after each start discarded)
#
#   baseline (frozen config, 8 warm runs / 3 starts)      2505.96 tok/s
#   gemm_tuned_table_tp4.patch alone (5 warm / 1 start)   2546.04 tok/s   +1.60%
#   + this patch                     (8 warm / 2 starts)  2569.26 tok/s   +2.53%
#
#   This patch's own contribution is the +0.91% difference between the last two rows. That is
#   under the restart-to-restart noise floor as a standalone delta, so it is reported as an
#   attribution by difference, not as an independently established result -- but it is the size
#   the kernel measurement predicts (2.17 us x 60 layers = 130 us against a 20.6 ms decode step
#   = 0.63% of decode, ~0.4% of wall clock) and mean TPOT moves with it, 20.25 -> 20.04 ms.
#
#   gsm8k 5-shot exact_match strict-match 0.9765 +/- 0.0042 on the stacked pair (gate 0.9691,
#   baseline 0.9773). This half of the stack cannot have contributed: its output is bit-identical.
#
#   Per-run numbers and the arm table are in FINDINGS.md section 6.
#   Raw benchmark output: results/final_w{1..5}_*, results/gemm_topk_w{1..3}_*.
#   Accuracy: eval_results/gemm_topk_gsm8k_20260820_133923 and eval_results/final_gsm8k_20260820_142652
#   -- two server instances, both 0.9765 (1288/1319), but not on the same 1288 questions: 4 flip
#   each way between two runs of the identical build, so the 1-answer gap to baseline is under the
#   stack's own run-to-run nondeterminism.
#
#   Applies cleanly on its own, but was only measured on top of gemm_tuned_table_tp4.patch.
#
diff --git a/csrc/kernels/topk_softmax_kernels.cu b/csrc/kernels/topk_softmax_kernels.cu
index c6bc743a5..deb15fa83 100644
--- a/csrc/kernels/topk_softmax_kernels.cu
+++ b/csrc/kernels/topk_softmax_kernels.cu
@@ -519,25 +519,24 @@ struct TopkConstants
 template <typename DTYPE,
           int EXPERTS,
           int WARPS_PER_TB,
-          int NUM_SHARED_EXPERTS = 0,
-          SharedExpertScoringFunc SCORING_FUNC = SharedExpertScoringFunc::NONE>
-void topkGatingSoftmaxLauncherHelper(const DTYPE* input,
-                                     const bool* finished,
-                                     float* output,
-                                     int* indices,
-                                     int* source_row,
-                                     const int num_rows,
-                                     const int k,
-                                     const int start_expert,
-                                     const int end_expert,
-                                     const int output_stride,
-                                     const int indices_stride,
-                                     const int input_stride,
-                                     const bool need_renorm,
-                                     hipStream_t stream)
+          int MAX_BYTES_PER_LDG,
+          int NUM_SHARED_EXPERTS,
+          SharedExpertScoringFunc SCORING_FUNC>
+void topkGatingSoftmaxLaunch(const DTYPE* input,
+                             const bool* finished,
+                             float* output,
+                             int* indices,
+                             int* source_row,
+                             const int num_rows,
+                             const int k,
+                             const int start_expert,
+                             const int end_expert,
+                             const int output_stride,
+                             const int indices_stride,
+                             const int input_stride,
+                             const bool need_renorm,
+                             hipStream_t stream)
 {
-    static constexpr std::size_t MAX_BYTES_PER_LDG = EXPERTS < 512 ? 32 : 64;
-
     static constexpr int BYTES_PER_LDG = MIN(MAX_BYTES_PER_LDG, sizeof(DTYPE) * EXPERTS);
     using Constants                    = topk_detail::TopkConstants<DTYPE, EXPERTS, BYTES_PER_LDG>;
     AITER_CHECK(EXPERTS / (Constants::ELTS_PER_LDG * WARP_SIZE) <= 1, "EXPERTS:", EXPERTS, " not supported");
@@ -581,6 +580,65 @@ void topkGatingSoftmaxLauncherHelper(const DTYPE* input,
     }
 }
 
+// Pick the load width, and with it THREADS_PER_ROW, from the row count.
+//
+// For EXPERTS >= 512 the stock 64-byte LDG puts VPT=32 elements in registers per
+// thread (2-byte DTYPE) and only 16 of the 64 lanes on a row. The top-k loop then
+// scans all 32 registers on each of its k-1 iterations -- 288 serialised compares
+// at k=10 -- and that chain, not bandwidth or occupancy, sets the runtime at small
+// row counts: measured on gfx950 the kernel is flat at ~10.6 us for every M from 64
+// to 512. Narrowing the LDG so THREADS_PER_ROW reaches the full 64-lane wavefront
+// cuts the chain 4x and quadruples the grid, and measures 8.1 us at M=64 (-23%).
+//
+// It is not free at large M. The narrow form issues 4x as many waves and each one
+// loads 4x less per instruction, so it crosses back over the wide form at roughly
+// M ~ 2000 (M=8192: 20.1 us narrow vs 13.1 us wide). Decode batches are tens of
+// rows and prefill chunks are thousands, so a row-count switch gets both: the
+// threshold below sits in the empty span between the two regimes.
+template <typename DTYPE,
+          int EXPERTS,
+          int WARPS_PER_TB,
+          int NUM_SHARED_EXPERTS = 0,
+          SharedExpertScoringFunc SCORING_FUNC = SharedExpertScoringFunc::NONE>
+void topkGatingSoftmaxLauncherHelper(const DTYPE* input,
+                                     const bool* finished,
+                                     float* output,
+                                     int* indices,
+                                     int* source_row,
+                                     const int num_rows,
+                                     const int k,
+                                     const int start_expert,
+                                     const int end_expert,
+                                     const int output_stride,
+                                     const int indices_stride,
+                                     const int input_stride,
+                                     const bool need_renorm,
+                                     hipStream_t stream)
+{
+    static constexpr int WIDE_BYTES_PER_LDG = EXPERTS < 512 ? 32 : 64;
+    // THREADS_PER_ROW = EXPERTS * sizeof(DTYPE) / BYTES_PER_LDG must stay <= 64.
+    static constexpr int NARROW_BYTES_PER_LDG =
+        MIN(WIDE_BYTES_PER_LDG, MAX(4, int(sizeof(DTYPE) * EXPERTS) / 64));
+    static constexpr int NARROW_MAX_ROWS = 2048;
+
+#define AITER_TOPK_DISPATCH_LDG(BYTES)                                                     \
+    topkGatingSoftmaxLaunch<DTYPE, EXPERTS, WARPS_PER_TB, BYTES, NUM_SHARED_EXPERTS,       \
+                            SCORING_FUNC>(input, finished, output, indices, source_row,    \
+                                          num_rows, k, start_expert, end_expert,           \
+                                          output_stride, indices_stride, input_stride,     \
+                                          need_renorm, stream)
+
+    if(NARROW_BYTES_PER_LDG != WIDE_BYTES_PER_LDG && num_rows <= NARROW_MAX_ROWS)
+    {
+        AITER_TOPK_DISPATCH_LDG(NARROW_BYTES_PER_LDG);
+    }
+    else
+    {
+        AITER_TOPK_DISPATCH_LDG(WIDE_BYTES_PER_LDG);
+    }
+#undef AITER_TOPK_DISPATCH_LDG
+}
+
 #define LAUNCH_SOFTMAX_WITH_SHARED(NUM_EXPERTS, WARPS_PER_TB, NUM_SHARED, SCORING)          \
     topkGatingSoftmaxLauncherHelper<DTYPE, NUM_EXPERTS, WARPS_PER_TB, NUM_SHARED, SCORING>(\
                                                                       gating_output,        \

# Write the bf16 MLA absorb bmm straight into a (tokens, heads, dim) buffer, so the
# post-GEMM `transpose(0, 1).flatten(1, 2)` is a free view instead of an `aten::copy_`.
#
# base:  sglang git 29481685462732237d80d86076d6563e1f658102, with round-1 patches 01+02+03
#        already applied. There is no git checkout for this file in the container, so the
#        pristine copies are kept in this bundle:
#          patches/base/forward_mla.py      -- stock at that commit
#          patches/applied/forward_mla.py   -- stock + patches 01/02/03, the base of THIS diff
#        The diff below is `diff -u patches/applied/forward_mla.py patches/arms/fl/forward_mla.py`
#        with a/ b/ prefixes added, so it applies with -p1 from the sglang root.
# apply: cd /sgl-workspace/sglang && git apply -p1 mla-absorb-bmm-write-token-major.patch
#        (or: patch -p1 < ...  from the same directory)
#
# depends on: patch 03 (03-mla-absorb-drop-unit-weight-scale.patch) only textually -- 03 replaced
#        the inline `self.w_vc.to(torch.bfloat16) * self.w_scale` with `_scaled_absorb_weight(...)`
#        on the same two lines this hunk rewrites. The optimisation itself is independent of 01,
#        02 and 03; to apply it on stock, substitute `self.w_vc.to(torch.bfloat16) * self.w_scale`
#        for `_scaled_absorb_weight(self.w_vc, self.w_scale)` in the `_w = ...` line.
#        It was measured on top of 01+02+03 plus the round-2 prefill first-slot guard
#        (dsa-prefill-first-slot-empty-block-guard.patch); those are all in the DSA prefill path
#        and do not touch the absorb bmm.
#
# what it does: for this checkpoint every MLA linear -- o_proj, q_a_proj, q_b_proj,
#        kv_a_proj_with_mqa, kv_b_proj -- is in the checkpoint's `quantization_config.exclude`
#        list for all 78 layers, so `w_vc` and `o_proj.weight` are bf16 and the live absorb path
#        is the plain `torch.bmm` one. bmm's output layout is (heads, tokens, dim); o_proj wants
#        (tokens, heads*dim). Transposing first makes the flatten non-view-able, so it silently
#        degrades to a full `aten::copy_` of the attention output, once per layer per forward.
#        Allocating the destination as (tokens, heads, dim) and passing its transpose as `out=`
#        puts the GEMM's writes where they are already wanted. The result then falls into the
#        `if _bmm_buf is not None:` block that this function already has -- whose bf16 arm is
#        `_bmm_buf.flatten(1, 2)`, a view. The same trick, with the same comment, is already
#        twelve lines above on the aiter MXFP4 branch; the bf16 branch just never got it.
#
# direct evidence the change fires: decode torch profile, 300 decode steps, rank 0, captured
#        through the /start_profile POST body so the launch configuration is untouched
#        (analysis/profile_decode2.py; summaries analysis/profile_decode_r2_tp0.json and
#        analysis/profile_decode_fl_tp0.json):
#            before  void at::native::elementwise_kernel_manual_unroll<..., nocast>
#                      23700 calls = 79.00/step,  5.05 us,  1.915% of decode GPU time
#            after    300 calls =  1.00/step, 17.60 us,  0.084% of decode GPU time
#        79/step = 78 attention layers + one unrelated sampler-path call; the 78 per-layer copies
#        are gone and the survivor is the sampler one. The strided `out=` costs the GEMM a little
#        (78 launches/step, 11.66 -> 11.84 us, ~14 us/step) against ~394 us/step of copy removed.
#        The kernel was attributed to its source line by rebuilding the Python stack from the
#        `python_function` event tree of a with_stack *prefill* capture (analysis/attribute.py):
#        312 of 429 `at::native` kernels in that trace, 79.3% of their time, one per layer per
#        pass, all landing on `forward_absorb_core` -> `Tensor.flatten`, dims [16258, 8, 256].
#
# measurement: A/B against the arm it was built on, interleaved across restarts, unmodified
#        run_bench.sh (192 prompts, concurrency 64, ISL 8192, OSL 1024) throughout.
#            fs  (= 01+02+03 + prefill first-slot guard)  1512.166 tok/s  n=15, 5 sessions
#            fl  (= fs + this patch)                      1530.461 tok/s  n=9,  3 sessions
#                                                                    +1.210%
#        The two distributions do not overlap at run level: worst fl run 1526.78 beats best fs
#        run 1518.05 by +0.58%. Session means (the independent unit -- runs inside one server
#        instance are correlated) also do not overlap: worst fl session 1528.07 vs best fs
#        session 1513.91. Welch on session means t=12.45, df=3.3, +18.29 tok/s, SE=1.47.
#        Noise floor measured on this same boot: within-instance p2p 0.11-0.49%, restart-to-restart
#        (spread of session means) 0.229% for fs and 0.287% for fl, run-level p2p 0.718%/0.491%.
#        +1.210% clears all of them, and clears round 1's 0.39% floor by 3x.
#        Against the round-1 reference arm re-measured on this boot (r1ref, 1508.187 tok/s,
#        n=9, 3 sessions) the combined round-2 total is +1.477%.
#        arms: results/fl_s7_r{1,2,3}_20260820_20*   1529.51 1526.78 1527.92
#              results/fl_s9_r{1,2,3}_20260820_21*   1527.78 1533.25 1531.53
#              results/fl_s11_r{1,2,3}_20260820_21*  1530.07 1534.30 1533.02
#        against results/fs_s{2,4,6,8,10}_r{1,2,3}_* and results/r1ref_s{1,3,5}_r{1,2,3}_*
#
# accuracy: gsm8k 5-shot strict-match 0.968916 +/- 0.004780
#           (eval_results/fl_gate_20260820_215927), against 0.970432 +/- 0.004666 for the arm it
#           was measured on (eval_results/fs_gate_20260820_202453) and for the stock-configuration
#           reference. PASSES: the gap is 2 problems out of 1319, under a third of one standard
#           error, and it is the same value round 1's patch 03 gate returned.
#           This change is NOT bit-identical by construction -- a strided `out=` can select a
#           different rocBLAS kernel, and therefore a different accumulation order, from the
#           contiguous one. The gate is the evidence here, and per FINDINGS.md sec 2c the gate
#           cannot resolve a regression below ~0.005, so this is "passes the gate", not "matches".
#
# risk / applicability: the win is decode-side and scales with layer count, not batch -- 5 us per
#        layer per step is launch-and-occupancy overhead, not bandwidth (256 KB in 5 us is
#        ~100 GB/s on a ~5 TB/s part). It is therefore worth more at low batch and worth nothing
#        at very large tokens-per-step. It only fires on the bf16 absorb path; checkpoints whose
#        kv_b_proj is fp8 or MXFP4 take the aiter branches, which already do this.
#
--- a/python/sglang/srt/models/deepseek_common/attention_forward_methods/forward_mla.py
+++ b/python/sglang/srt/models/deepseek_common/attention_forward_methods/forward_mla.py
@@ -1170,10 +1170,24 @@
                         dtype=torch.bfloat16,
                     )
                 else:
-                    attn_bmm_output = torch.bmm(
-                        attn_output.to(torch.bfloat16).transpose(0, 1),
-                        _scaled_absorb_weight(self.w_vc, self.w_scale),
+                    _x = attn_output.to(torch.bfloat16).transpose(0, 1)
+                    _w = _scaled_absorb_weight(self.w_vc, self.w_scale)
+                    # Write the bmm straight into a (tokens, heads, dim) buffer --
+                    # the same trick the aiter mxfp4 branch above already uses --
+                    # so the post-GEMM `transpose(0, 1).flatten(1, 2)` is a free
+                    # view. bmm's natural output layout is (heads, tokens, dim);
+                    # flattening its transpose is not view-able, so it fell through
+                    # to an `aten::copy_` (`elementwise_kernel_manual_unroll`) once
+                    # per layer per decode step -- 1.91% of decode GPU time here.
+                    _bmm_buf = torch.empty(
+                        _x.shape[1],
+                        _x.shape[0],
+                        _w.shape[2],
+                        device=_x.device,
+                        dtype=torch.bfloat16,
                     )
+                    torch.bmm(_x, _w, out=_bmm_buf.transpose(0, 1))
+                    attn_bmm_output = _bmm_buf.transpose(0, 1)
 
             if _bmm_buf is not None:
                 # _bmm_buf is already (batch, heads, dim) contiguous

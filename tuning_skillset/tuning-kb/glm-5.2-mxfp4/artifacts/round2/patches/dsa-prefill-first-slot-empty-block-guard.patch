+# Opt-in (default off): check the invariant the TileLang prefill kernel's cheap
+# "first-slot" empty-block guard rests on -- that the -1 padding in each DSA index
+# row is a contiguous SUFFIX, so testing slot 0 of a 64-wide block decides whether
+# the whole block is dead.
+#
+# Why this exists: when the invariant is violated the guard does not crash, it
+# silently drops real KV keys from the attention. That degrades answers in a way
+# no assertion catches and a 1319-problem gsm8k run cannot resolve. The invariant
+# was verified against 4.06e9 live index blocks under --dsa-topk-backend
+# sgl-kernel, but it is a property of the top-k producer, and at least one other
+# backend violates it by construction: flashinfer's unfused path calls
+# flashinfer.top_k(..., sorted=False) and masks -inf to -1 in place, scattering
+# the -1s through the row. Anyone running an unverified configuration should turn
+# this on once and convert a silent wrong answer into a loud failure.
+#
+# Cost when off: one predicted branch on a module-level constant per prefill layer
+# call (~8k times per benchmark, ~0.25 ms total). Not measurable.
+_ASSERT_TOPK_SUFFIX = get_bool_env_var("SGLANG_DSA_ASSERT_TOPK_SUFFIX")
+_ASSERT_TOPK_SUFFIX_BI = 64
+
+
+def _assert_topk_suffix(idx: torch.Tensor) -> None:
+    """Raise if the -1 padding in `idx` ([num_tokens, topk] int32) is not a suffix.
+
+    Checks the strong property (no -1 anywhere followed by a valid slot), which
+    implies the block-level property the guard needs. Synchronizes, so this is a
+    debugging tool and not something to leave on in production.
+    """
+    if idx.ndim != 2 or idx.shape[0] == 0:
+        return
+    valid = idx >= 0
+    bad = ((~valid[:, :-1]) & valid[:, 1:]).any()
+    if bool(bad):
+        row = int(((~valid[:, :-1]) & valid[:, 1:]).any(dim=1).nonzero()[0, 0])
+        raise RuntimeError(
+            "DSA top-k index row has non-suffix -1 padding, which makes the "
+            "TileLang first-slot empty-block guard silently drop real KV keys. "
+            f"First offending row {row}: {idx[row].tolist()!r}. "
+            "This configuration's top-k producer violates the invariant the "
+            "guard assumes -- see skip_mode='first' in tilelang_kernel.py."
+        )
+
 

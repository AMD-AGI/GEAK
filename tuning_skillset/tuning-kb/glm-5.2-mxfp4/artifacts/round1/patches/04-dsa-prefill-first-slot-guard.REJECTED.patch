# REJECTED IN ROUND 1 -- SUPERSEDED IN ROUND 2. Kept per patches/README.md as the record of
# what was measured and why it was held back.
#
# Round 2 settled the correctness objection below empirically: the contiguous-suffix invariant
# was checked against 4,059,581,952 live index blocks across 126,861,936 rows at ISL 8192
# (24.99% of them partially padded, i.e. the discriminating case) with zero violations, and the
# only topk producer reachable under the frozen launch config was identified by direct
# observation as sgl_kernel.fast_topk_transform_fused. The adopted version, which also carries
# an opt-in assertion for the invariant, is
#     patches/dsa-prefill-first-slot-empty-block-guard.patch
# Its end-to-end value measured +0.264% over 5 sessions, NOT the +0.64% extrapolated below, and
# is below this boot's noise floor and not claimed as a win -- see that patch's
# header and FINDINGS.md section 2.
#
#
# Switch candidate A's empty-index-block guard from an any-valid reduce to a single
# first-slot test.
#
# base:  applies ON TOP OF 01-dsa-prefill-skip-empty-index-blocks.patch.
#        Stacked, not independent: it edits the guard that 01 introduces, and it will not
#        apply to stock sglang. See the "independence" note in 01's header.
#        Pristine chain: patches/base/tilelang_kernel.py (clean at sglang 2948168546)
#        -> 01 -> patches/applied/tilelang_kernel.py -> this patch.
# apply: cd /sgl-workspace/sglang
#        git apply -p1 01-dsa-prefill-skip-empty-index-blocks.patch
#        git apply -p1 rejected/04-dsa-prefill-first-slot-guard.patch
#
# measurement: isolated, interleaved, HIP-graph timed (analysis/bench_dsa_prefill.py),
#              against stock 4.415 ms on the prefill shape and 34.55 us on the decode shape:
#
#                  guard              prefill    decode
#                  any-valid reduce   1.039x     0.927x     <- shipped, as patch 01
#                  first-slot test    1.067x     0.961x     <- this patch
#
#              Worth roughly +0.64% more end-to-end than 01 on top of 01's +1.33%.
#              NOT measured end to end: it was rejected before it earned server time, and
#              this header does not claim a throughput number it did not take.
#
# accuracy: not gated. See below -- the objection is not one gsm8k can answer.
#
# Why it was rejected
# -------------------
# It is correct only under an invariant this file does not own: that the -1 padding in an
# index row is always a contiguous SUFFIX, so testing slot 0 of a 64-block decides the whole
# block. That holds for the two producers that were read -- naive_paged_transform in
# kernels/aot/csrc/elementwise/deepseek_v4_topk.hip writes page_to_slot(i) for i < length and
# -1 above it, and the radix_topk branch (length > topk) pads not at all -- and it is
# preserved by _pad_topk_indices, _allocate_prefill_result and
# transform_index_page_table_prefill_kernel, which fill or copy whole rows.
#
# But four topk backends can produce this tensor (sgl-kernel v1, sgl-kernel v2, torch,
# flashinfer) and each would have to keep the invariant, in every future version. A violation
# does not fail loudly: it silently drops real KV keys from the attention, degrading answers
# in a way no assertion catches and a 1319-problem gsm8k run would probably not resolve. The
# reduce-based guard in 01 assumes nothing about the arrangement and is bit-exact by
# construction, so 0.64% was not judged worth resting a correctness claim on an invariant
# that could not be closed statically across all four.
#
# One further measurement worth keeping: the first-slot guard STILL costs 4% at decode
# (0.961x) despite having no reduce and no extra LDS at all. So the branch itself, not the
# reduce, is most of the decode penalty -- 01's prefill-only dispatch would be required
# either way, and a reviewer tempted by this variant does not get to drop it.
--- a/python/sglang/kernels/ops/attention/dsa/tilelang_kernel.py
+++ b/python/sglang/kernels/ops/attention/dsa/tilelang_kernel.py
@@ -1077,6 +1077,7 @@
     inner_iter=1,
     threads=256,
     skip_empty=False,
+    skip_mode="reduce",
 ):
     assert d_v == 512, f"only support d_v=512"
     assert (
@@ -1198,7 +1199,7 @@
                     valid = idx >= 0
                     page_idx_shared[bi_i] = T.if_then_else(valid, idx, 0)
                     mask[bi_i] = valid
-                    if skip_empty:
+                    if skip_empty and skip_mode == "reduce":
                         valid_i32[0, bi_i] = T.if_then_else(valid, 1, 0)
 
                 # Skip index blocks that are entirely -1 padding.
@@ -1231,11 +1232,32 @@
                 # because at decode no block is ever all-padding (every sequence is longer
                 # than topk), the guard never fires, and it costs a measured 8%. See
                 # tilelang_sparse_fwd for the prefill-only dispatch.
-                if skip_empty:
+                if skip_empty and skip_mode == "reduce":
                     T.reduce_max(valid_i32, any_valid, dim=1, clear=True)
                 # Block-uniform, so the __syncthreads inside T.copy/T.gemm below stay
                 # collective across the whole block.
-                guard = (any_valid[0] > 0) if skip_empty else True
+                #
+                # skip_mode selects how the predicate is computed:
+                #
+                #   "reduce" -- OR the per-lane validity across the block. Assumes nothing
+                #     about how the -1s are arranged, but costs a cross-lane AllReduce plus
+                #     its LDS workspace. Measured 1.039x on the prefill shape.
+                #
+                #   "first" -- test only indices[..., topk_block_i * BI]. A single scalar
+                #     load, already block-uniform, no reduce and no extra LDS. Measured
+                #     1.067x. Correct ONLY because the -1s are a contiguous suffix of each
+                #     row, which is a property of the topk producers and not of this file:
+                #     naive_paged_transform in deepseek_v4_topk.hip writes real slots for
+                #     i < length and -1 above, and the radix_topk branch (length > topk)
+                #     writes no -1 at all. If any producer ever interleaves -1s this mode
+                #     silently drops real KV keys instead of failing -- which is why it is
+                #     an explicit named choice and why it is not the default.
+                if not skip_empty:
+                    guard = True
+                elif skip_mode == "first":
+                    guard = indices[b_i, s_i, g_i, topk_block_i * BI] >= 0
+                else:
+                    guard = any_valid[0] > 0
                 if guard:
                     for bi_i, j in T.Parallel(BI, group_size):
                         page = page_idx_shared[bi_i]
@@ -1404,6 +1426,7 @@
                 inner_iter=inner_iter,
                 threads=threads,
                 skip_empty=q.shape[0] >= _SKIP_EMPTY_MIN_TOKENS,
+                skip_mode="first",
             )
         else:
             if _is_gfx95_supported:

# 03-kda-packed-decode-warps16.diff
#
# KDA packed-decode kernel: 8 warps per CTA -> 16.
#
# Origin:  mine.
# Base:    sglang 0.5.15.post1.dev20260723+g6c9fd0adc5,
#          git 0e756912eb3cd8f531f95c17299485b9312b2534. The container ships
#          sglang as an editable checkout at /sgl-workspace/sglang, so the
#          pristine copy is `git show 0e756912e:python/sglang/kernels/ops/
#          attention/kda_packed_decode.py`.
# Apply:   cd /sgl-workspace/sglang && git apply <this file>
# Stack:   measured as part of arm D, on top of 01 and 02, together with 04+05.
#          Independent of them in mechanism -- it touches only the KDA kernel's
#          launch geometry -- but it was never measured end to end on its own,
#          because in isolation it is worth ~0.5% of decode GPU time, which is
#          below this machine's 0.71% across-restart noise floor. That is the
#          honest reason it is bundled rather than reported separately.
#
# Isolated measurement: analysis/bench_kda.py, graph-captured, at the frozen
#          decode shape (B=63, HV=12, K=V=128, 99 MB of fp32 state per call):
#          kWarps 8 -> 31.0 us, kWarps 16 -> 28.3 us, 1.095x, and the output
#          and the updated state are bitwise identical to kWarps=8. 32 warps
#          regresses. `_WARPS` is a JIT template argument, so this changes the
#          compiled module name too and cannot silently reuse a stale build.
# In-server: analysis/profiles/candD_s7/kernel_table.txt --
#          kda_packed_decode_kernel<16,false> 1.91 ms/69 calls (5.44% of
#          decode) against <8,false> 2.14 ms/69 (5.93%) in
#          analysis/profiles/candC_s3/. Kernel identity in the profile is the
#          engagement proof: the template argument is in the symbol.
# End-to-end: arm D (01+02+03+04+05) 949.964 tok/s, mean of 7 settled runs over
#          2 server restarts (sd 2.606), against arm C (01+02) 936.952, mean of
#          10 runs over 3 restarts (sd 1.318): +1.389%, which is 1.95x this
#          machine's 0.713% across-restart noise floor. +18.19% over the local
#          baseline of 803.786. gsm8k 5-shot strict-match 0.9788 +/- 0.0040
#          (gate 0.9765 +/- 0.0042), eval_results/candD_s7_20260820_163121.
#          03 is not separable from 04+05 within that floor; see Stack above.
diff --git a/python/sglang/kernels/ops/attention/kda_packed_decode.py b/python/sglang/kernels/ops/attention/kda_packed_decode.py
index 364e6ea41..fa4ce0df9 100644
--- a/python/sglang/kernels/ops/attention/kda_packed_decode.py
+++ b/python/sglang/kernels/ops/attention/kda_packed_decode.py
@@ -24,7 +24,12 @@ from sglang.kernels.jit.utils import (
 if TYPE_CHECKING:
     from tvm_ffi.module import Module
 
-_WARPS: int = 8
+# One CTA per (batch, head): at K3's 12 heads/rank a bs-63 decode launches 756
+# CTAs, so on gfx950's 256 CUs each CU holds ~3 and the row loop is the only
+# latency hiding there is. 8 warps of 32 is 4 wave64s per CTA -- widening to 16
+# doubles the rows in flight for the same state traffic and measures 1.095x at
+# the frozen decode shape (analysis/bench_kda.py), bitwise-identical output.
+_WARPS: int = 16
 # The row-streaming layout needs enough (batch x head) CTAs to fill the GPU;
 # below this the triton kernel's launch cost is already the floor.
 _MIN_BATCH: int = 8

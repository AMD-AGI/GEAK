+# Split granularity for the batched grouped/MLA decode path.
+#
+# stage1 emits one fp32 partial ([512] logits + lse) per (batch, head, split);
+# stage2 reads them all back.  That mid_o round trip is pure synthetic traffic
+# on a kernel that is at ~79-93% of achievable HBM bandwidth, so its size --
+#   batch * heads * n_live_splits * 512 * 4 B, twice --
+# is a first-order term.  Rounding each split's KV length up to a LARGER
+# multiple makes every split fatter and mechanically shrinks n_live_splits,
+# deleting partials linearly.  The counterweight is parallelism, so this is
+# only applied when the batch dimension alone already floods the device.
+#
+# HARD INVARIANT: stage2 derives
+#   kv_len_per_split = cdiv(cdiv(seq, kv_splits), MIN_BLOCK_KV) * MIN_BLOCK_KV
+#   n_live_splits    = min(cdiv(seq, kv_len_per_split), MAX_KV_SPLITS)
+# and assumes stage1 wrote splits 0..n_live_splits-1 contiguously.  Both
+# kernels therefore MUST be launched with the SAME MIN_BLOCK_KV -- that is why
+# the value is threaded from the grouped launcher into the stage2 launcher
+# instead of being read from the module constant in two places.
+# Split granularity for the batched grouped/MLA decode path (see the block
+# comment above): align to BLOCK_N so no split ends on a ragged KV tile.
+_MIN_BLOCK_KV_BATCHED = 16
+
+_SIMDS_PER_CU = 4
+_NUM_SIMDS_CACHE = []
+
+
+def _num_simds() -> int:
+    """SIMD count of the current device (CUs x 4 on CDNA).  Host-only query,
+    cached after the first call -- safe under HIP-graph capture."""
+    if not _NUM_SIMDS_CACHE:
+        n = 1024
+        try:
+            import torch
+
+            n = (
+                torch.cuda.get_device_properties(
+                    torch.cuda.current_device()
+                ).multi_processor_count
+                * _SIMDS_PER_CU
+            )
+        except Exception:  # pragma: no cover - non-GPU / query failure
+            pass
+        _NUM_SIMDS_CACHE.append(int(n) if n else 1024)
+    return _NUM_SIMDS_CACHE[0]
+
+
+def _grouped_split_target(batch, head_num, kv_head_num, max_kv_splits) -> int:
+    """Number of KV splits to force for the batched grouped decode, or 0 to
+    honour the host-supplied ``num_kv_splits[b]``.
+
+    stage1 runs at num_warps=1, so ONE block == ONE wave.  The grid is
+    ``batch x head_groups x splits``; the measured surface is a hard staircase
+    in ``blocks / SIMD``: at batch=64/seq=8704 the m=64 bucket measures
+    16 splits (1024 blocks, exactly 1 wave per SIMD) = 0.1649 ms,
+    17 splits (1088 blocks) = 0.2323 ms, 20 = 0.2253, 32 (2048 = 2 waves)
+    = 0.1864, 34 = 0.2193, and the stock host split count (28 live) = 0.1922.
+    One block spilling into a second wave costs a whole extra wave, so we pick
+    the LARGEST split count that still FLOORS into a whole number of waves --
+    which simultaneously minimises the mid_o partial round trip (16 partials
+    instead of 28 = 26 MB instead of 46 MB written and read back).
+
+    Everything here is a host constant (python ints from tensor shapes), so
+    the launch stays HIP-graph-capture safe.
+    """
+    if not _is_hip or batch < 8:
+        return 0
+    kv_group_num = max(head_num // max(kv_head_num, 1), 1)
+    head_groups = triton.cdiv(head_num, min(16, kv_group_num))
+    blocks_per_split = batch * head_groups
+    if blocks_per_split <= 0:
+        return 0
+    target = _num_simds() // blocks_per_split
+    if target < 1:
+        # The batch x head grid alone already fills the device; leave the
+        # host's split heuristic alone.
+        return 0
+    return int(min(target, max_kv_splits))
+
+
+def _grouped_min_block_kv(batch: int) -> int:
+    """Host-constant (batch is a python int) -> HIP-graph-capture safe."""
+    if _is_hip and batch >= 8:
+        return _MIN_BLOCK_KV_BATCHED
+    return _MIN_BLOCK_KV
+
+# Stage-2 (softmax reduce) launch tuning.
+#
+# RE-TUNED JOINTLY with (a) the bf16 split partials (see _narrow_mid_o below)
+# and (b) the right-sized split count (_grouped_split_target -> 16 live splits
+# instead of 28).  Both shrink the mid_o round trip, which moves the stage2
+# optimum off the fp32/28-split point of (BLOCK_S=16, num_warps=4): 256 lanes
+# over a bf16 [16,512] tile collapse the per-lane load width and lengthen the
+# cross-lane reduce.  One wave per (batch, head) row keeps the loads wide and
+# the axis-0 reduce intra-thread.  Paired sweep ON THIS merged body (weighted):
+# (16,1)=2.64 med, (8,1)=2.58 med, (32,1)=2.54, (16,2)=2.59, (16,4)=2.60,
+# (4,1)=2.60.
+_S2_BLOCK_S = 16
+_S2_NUM_STAGES = 1
+_S2_NUM_WARPS = 1
+
 

      "lifecycle": "active",
      "type": "lever",
      "confidence": "★★",
      "effect": "24.08x weighted cumulative vs frozen baseline; per-case c2 24.29x, c32 23.76x, c64 23.88x (all three within 2%); roofline-emp 0.05 latency-bound -> 0.55 compute-bound",
      "attempts": 3,

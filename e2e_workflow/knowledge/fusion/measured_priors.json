  "schema_version": 2,
  "artifact": "fusion_measured_priors",
  "note": "Fusion seams with MEASURED end-to-end results, positive (a win) or negative (a regression alone or when stacked). Read by scripts/fusion_screen.py: a positive prior whose effective gain clears the noise band and whose seam is present in the trace is forced into the final list (without taking a Top-K slot) and ranks first in pass 2; a negative prior multiplies a matching window's difficulty by 3, is never forced and sorts last. The store is append-only: scripts/fusion_prior_writeback.py appends measurements through fusion_priors.append_measurement; the effective gain is the median of the last 3 measurements by date. The seam descriptor is the screen's matching aid (ordered member patterns over the semantic table rows), not part of the measurement.",
  "seam_member_fields": {
    "cls": "fusion_screen row class (gemm, topk, quant, norm, rope, kv_cache, activation, elementwise, allreduce, ...)",
    "module": "dotted module suffix that must appear in the row's contained_by (skipped when the row has no module evidence)",
    "module_any": "any of these module suffixes",
    "name": "name phrases (token match, fusion_catalog phrase syntax); any one must hit",
    "op": "parent canonical operator (e.g. aten::sigmoid)",
    "role": "fused (removed/merged by the fusion, default) or context (locates the seam, stays)"
  },
  "seam_fields": {
    "kinds": "window kinds the seam may be found as (serial, sibling, parallel, epilogue_forward, fan_out, seam_rewrite)",
    "max_span": "rows between the first and last member",
    "members": "ordered member patterns (see seam_member_fields)",
    "phases": "optional: phases the measurement covered; on a table blind to a required phase a prior without phases is not forced",
    "tags": "tag-only seam (op tags) when no member patterns exist"
  },
  "measurement_fields": {
    "gain_pct": "measured e2e gain in percent (negative = regression)",
    "date": "YYYY-MM-DD",
    "protocol": "workload / serving protocol of the measurement",
    "source": "who / what measured it",
    "evidence": "path to the evidence, or null"
  },

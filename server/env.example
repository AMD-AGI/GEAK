# GEAK Online Service Configuration

# Application
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
# External URL for download links (optional, for MCP responses)
# If not set, defaults to http://localhost:PORT
EXTERNAL_BASE_URL=

# SaFE Platform (Required)
SAFE_API_BASE=https://safe.example.com
# System-level API key for background task status checks (Optional)
# If not set, falls back to log-based status detection
SAFE_SYSTEM_API_KEY=

# GEAK Repository
GEAK_REPO_URL=https://github.com/AMD-AGI/GEAK.git
GEAK_BRANCH=geak_online

# Database
DATABASE_PATH=./data/geak.db

# Storage
NFS_BASE_PATH=/wekafs/geak

# Default Runtime
DEFAULT_IMAGE=harbor.amd.com/rocm/mini-swe-agent:latest
DEFAULT_GPU_COUNT=1
DEFAULT_TIMEOUT=3600
DEFAULT_CPU=4
DEFAULT_MEMORY=16Gi

# Entrypoint pre-command (runs before main logic in workload, e.g. trust self-signed certs)
# ENTRYPOINT_PRECOMMAND="cp /shared_nfs/geak/certs/*.crt /usr/local/share/ca-certificates/ && update-ca-certificates"

# Test Configuration (for running tests)
TEST_BASE_URL=http://localhost:8000
# TEST_API_KEY - SaFE platform API key (ak-xxx), used for API authentication
TEST_API_KEY=
# TEST_LLM_BASE - LLM Gateway URL, used for model configuration
TEST_LLM_BASE=http://litellm-service.primus-safe.svc.cluster.local:4000/v1
# TEST_LLM_KEY - LLM Gateway API key for test
TEST_LLM_KEY=

# Langfuse Configuration (Optional - zero-intrusion LLM call tracing)
# When enabled, all LLM calls in mini-swe-agent will be traced via litellm callbacks
# Note: The URL should include any path prefix (e.g., /langfuse for self-hosted instances)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
+def load_cleaned_contract(manifest, path, *, artifact_root, expected_digest):
+    """Read the task at root preflight using only pinned contract-reader sources.
+
+    Empty private package paths disable normal package discovery. This closure
+    imports no cleaned host/model code and never imports the task's source.
+    """
+    root = immutable(manifest["cleaned_root"])
+    names = ("_util", "evaluate.jobs_v1", "evaluate.jobs", "evaluate.external",
+             "evaluate.native_contract", "evaluate.generated_task")
+    source_refs = {}
+    for name in names:
+        relative = "geak_evo/" + name.replace(".", "/") + ".py"
+        ref = manifest["cleaned_source_refs"][relative]
+        need(ref["path"] == str(root / relative) and ref in manifest["source_refs"],
+             "contract reader omitted from pinned cleaned source closure")
+        source_refs[name] = (ref, checked(ref))
+    namespace = "_geak_evo_pilot_contracts"
+    need(not any(key == namespace or key.startswith(namespace + ".") for key in sys.modules),
+         "fresh contract reader namespace required")
+    for name in (namespace, namespace + ".evaluate"):
+        package = ModuleType(name)
+        package.__path__ = []
+        sys.modules[name] = package
+    modules = {}
+    for name, (ref, raw) in source_refs.items():
+        module = ModuleType(namespace + "." + name)
+        module.__file__ = ref["path"]
+        module.__package__ = module.__name__.rpartition(".")[0]
+        sys.modules[module.__name__] = module
+        # Execute authenticated bytes directly; -B alone does not forbid
+        # SourceFileLoader from reading an unregistered bytecode cache.
+        exec(compile(raw, ref["path"], "exec", dont_inherit=True), module.__dict__)
+        modules[name] = module
+    return modules["evaluate.jobs"].load_engineer_job(
+        path, artifact_root=artifact_root, expected_digest=expected_digest)



+def load_cleaned_publisher_contract(manifest):
+    """Bind root validation to the exact ordinary producer's read-only helpers.
+
+    Only this fixed closure is loaded; empty package paths forbid discovery of
+    another module or bytecode cache. No cleaned host, model transport or native
+    launcher is imported, and the canonical retained namespace is unchanged.
+    """
+    root = immutable(manifest["cleaned_root"])
+    names = ("_util", "archive.store", "archive.refs", "archive.claims", "archive.policy",
+             "archive.trials", "archive.succession", "planner.context", "engineer.instructions")
+    source_refs = {}
+    for name in names:
+        relative = "geak_evo/" + name.replace(".", "/") + ".py"
+        ref = manifest["cleaned_source_refs"][relative]
+        need(ref["path"] == str(root / relative) and ref in manifest["source_refs"],
+             "publisher reader omitted from pinned cleaned source closure")
+        source_refs[name] = (ref, checked(ref))
+    namespace = "_geak_evo_publisher_contract"
+    need(not any(key == namespace or key.startswith(namespace + ".") for key in sys.modules),
+         "fresh publisher reader namespace required")
+    for name in (namespace, namespace + ".archive", namespace + ".planner", namespace + ".engineer"):
+        package = ModuleType(name)
+        package.__path__ = []
+        sys.modules[name] = package
+    modules = {}
+    for name, (ref, raw) in source_refs.items():
+        module = ModuleType(namespace + "." + name)
+        module.__file__ = ref["path"]
+        module.__package__ = module.__name__.rpartition(".")[0]
+        sys.modules[module.__name__] = module
+        exec(compile(raw, ref["path"], "exec", dont_inherit=True), module.__dict__)
+        modules[name] = module
+    parents = modules["archive.succession"]
+    return SimpleNamespace(parent_snapshot=parents.parent_snapshot, archive_files=parents.archive_files,
+        selected_parent_material=parents.selected_parent_material,
+        tool_addendum=modules["engineer.instructions"].tool_addendum,
+        bound_evidence=modules["archive.store"].ResearchStore._bound_evidence)
+
+

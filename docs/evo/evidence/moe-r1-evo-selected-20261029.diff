new file mode 100644
index 0000000000000000000000000000000000000000..3b294b40b8869c7465f10849f0d0d85ccb9061db
--- /dev/null
+++ b/source/prefill_native.py
@@ -0,0 +1,200 @@
+# SPDX-License-Identifier: MIT
+"""Lazy native BM64 direct-output stage2 with no cached tensor state."""
+
+import ctypes
+from functools import lru_cache
+import hashlib
+import json
+import sys
+from pathlib import Path
+import subprocess
+
+import torch
+
+from aiter.ops.opus.moe_stage2_a8w4 import (
+    _contiguous,
+    _optional_contiguous,
+    _pad_scale_cols,
+    _pad_scale_rows,
+)
+
+
+class _Stage2Args(ctypes.Structure):
+    _fields_ = [
+        (name, ctypes.c_void_p)
+        for name in (
+            "inter_states_fp8", "w2_fp4", "a2_scale_e8m0", "w2_scale_e8m0",
+            "sorted_token_ids", "sorted_weights", "sorted_expert_ids",
+            "num_valid_ids", "out_bf16",
+        )
+    ] + [
+        (name, ctypes.c_int64)
+        for name in (
+            "stride_a_t", "stride_a_k", "stride_w_e", "stride_w_h",
+            "stride_a_scale_route", "stride_w_scale_row", "stride_o_t",
+        )
+    ] + [
+        (name, ctypes.c_int32)
+        for name in (
+            "token_num", "topk", "num_experts", "model_dim", "sorted_blocks",
+            "sort_block_m", "a_scale_rows", "route_out_fp8", "k_tiles",
+            "a_scale_words_per_row_pack", "w_scale_words_per_row_pack",
+        )
+    ] + [("route_out_row_bytes", ctypes.c_int64)]
+
+
+assert ctypes.sizeof(_Stage2Args) == 184
+def _run_build(argv, build_dir, stem):
+    result = subprocess.run(argv, cwd=build_dir, capture_output=True, text=True)
+    (build_dir / (stem + ".stdout")).write_text(result.stdout)
+    (build_dir / (stem + ".stderr")).write_text(result.stderr)
+    if result.returncode:
+        raise RuntimeError(
+            f"Prefill stage2 {stem} failed ({result.returncode}): {result.stderr[-6000:]}"
+        )
+
+
+@lru_cache(maxsize=1)
+def _native_library():
+    """Compile static code lazily into a content-keyed run-local directory."""
+    import aiter
+
+    source_dir = Path(__file__).resolve().parent
+    native_source = source_dir / "prefill" / "native_direct.hip"
+    csrc = Path(aiter.__file__).resolve().parent.parent / "csrc"
+    flags = [
+        "-x", "hip", "-shared", "-fPIC", "-O3", "-std=c++20", "--offload-arch=gfx950",
+        "-fgpu-flush-denormals-to-zero", "-fno-offload-uniform-block",
+        "-mllvm", "--amdgpu-kernarg-preload-count=32",
+        "-mllvm", "--lsr-drop-solution=1",
+        "-mllvm", "-amdgpu-early-inline-all=true",
+        "-mllvm", "-amdgpu-function-calls=false",
+        "-mllvm", "--amdgpu-mfma-vgpr-form",
+        "-mllvm", "-enable-post-misched=1",
+        "-D__Float4_e2m1fn_x2", "-DENABLE_CK=0",
+    ]
+    inputs = [Path(__file__).resolve(), native_source,
+              csrc / "opus_moe" / "gen_instances.py",
+              csrc / "opus_moe" / "opus_moe_common.py"]
+    for include_dir in (csrc / "include", csrc / "opus_moe" / "include"):
+        inputs.extend(sorted(p for p in include_dir.rglob("*")
+                             if p.is_file() and p.suffix in (".h", ".hpp", ".cuh")))
+    key = hashlib.sha256(json.dumps(flags).encode())
+    for path in inputs:
+        key.update(str(path.relative_to(csrc) if path.is_relative_to(csrc) else path.name).encode())
+        key.update(path.read_bytes())
+    # Matches the admitted decode loader: both local and captured workspaces
+    # place static artifacts beside the workspace, never in candidate source.
+    build_dir = source_dir.parent.parent / "prefill_stage2_build" / key.hexdigest()
+    build_dir.mkdir(parents=True, exist_ok=True)
+    library_path = build_dir / "prefill_stage2.so"
+    if not library_path.is_file():
+        _run_build([sys.executable, "-B", str(csrc / "opus_moe" / "gen_instances.py"),
+                    "--working_path", str(build_dir)], build_dir, "generate")
+        temporary_library = build_dir / "prefill_stage2.building.so"
+        command = ["/opt/rocm/bin/hipcc", *flags,
+                   "-I" + str(csrc / "include"),
+                   "-I" + str(csrc / "opus_moe" / "include"),
+                   "-I" + str(csrc / "opus_gemm" / "include"),
+                   "-I" + str(build_dir), str(native_source), "-o", str(temporary_library)]
+        (build_dir / "build_command.json").write_text(json.dumps(command, indent=2))
+        _run_build(command, build_dir, "compile")
+        temporary_library.replace(library_path)
+    native = ctypes.CDLL(str(library_path))
+    native.prefill_direct_abi_size.argtypes = []
+    native.prefill_direct_abi_size.restype = ctypes.c_size_t
+    native.prefill_direct_abi_offset.argtypes = [ctypes.c_int]
+    native.prefill_direct_abi_offset.restype = ctypes.c_size_t
+    if native.prefill_direct_abi_size() != ctypes.sizeof(_Stage2Args):
+        raise RuntimeError("Prefill stage2 native Kargs size mismatch")
+    for index, (name, _) in enumerate(_Stage2Args._fields_):
+        if native.prefill_direct_abi_offset(index) != getattr(_Stage2Args, name).offset:
+            raise RuntimeError(f"Prefill stage2 native Kargs offset mismatch: {name}")
+    native.prefill_direct_launch.argtypes = [ctypes.POINTER(_Stage2Args), ctypes.c_void_p]
+    native.prefill_direct_launch.restype = ctypes.c_int
+    native.prefill_direct_error_string.argtypes = [ctypes.c_int]
+    native.prefill_direct_error_string.restype = ctypes.c_char_p
+    return native
+
+
+def native_direct_stage2(*, ordinary_stage2, stage2_args, stage2_kwargs):
+    """Stage2 override: current sorted FP8 A2 to zeroed BF16 atomic output."""
+    a2, _w1, w2, sorted_ids, sorted_experts, valid_ids, out, topk = stage2_args
+    if (
+        stage2_kwargs["block_m"] != 64
+        or a2.ndim not in (2, 3)
+        or a2.shape[-1] != 384
+        or tuple(w2.shape) != (384, 7168, 192)
+        or tuple(out.shape) != (8192, 7168)
+        or topk != 6
+        or stage2_kwargs.get("inter_dim_pad", 0) != 0
+        or out.dtype != torch.bfloat16
+        or not out.is_contiguous()
+    ):
+        raise ValueError(
+            f"Native direct stage2 interface mismatch: A2={tuple(a2.shape)}, "
+            f"W2={tuple(w2.shape)}, out={tuple(out.shape)}, topk={topk}, "
+            f"block_m={stage2_kwargs['block_m']}"
+        )
+    if stage2_kwargs.get("bias2") is not None:
+        raise ValueError("Native direct stage2 does not support bias2")
+    if stage2_kwargs.get("expert_mask") is not None or stage2_kwargs.get("topk_ids") is not None:
+        raise ValueError("Native direct stage2 does not support expert masking")
+
+    native = _native_library()
+    # The 384-wide logical K has three 128-wide MFMA steps. Its last scale
+    # group is stored in a padded 16-column scale row, as in the original host
+    # wrapper. Preserve the actual strides after padding rather than using 12.
+    scale_rows = ((sorted_ids.numel() + 31) // 32) * 32
+    a2_scale = _pad_scale_cols(_pad_scale_rows(stage2_kwargs["a2_scale"], scale_rows), 16)
+    w2_scale = _pad_scale_cols(stage2_kwargs["w2_scale"], 16)
+    a2 = _contiguous(a2)
+    w2 = _contiguous(w2)
+    a2_scale = _contiguous(a2_scale)
+    w2_scale = _contiguous(w2_scale)
+    sorted_ids = _contiguous(sorted_ids)
+    sorted_experts = _contiguous(sorted_experts)
+    valid_ids = _contiguous(valid_ids)
+    sorted_weights = _optional_contiguous(stage2_kwargs.get("sorted_weights"))
+    tensors = (a2, w2, a2_scale, w2_scale, sorted_ids, sorted_experts, valid_ids)
+    if any(t.device != out.device for t in tensors):
+        raise ValueError("Native direct stage2 tensors must be on one device")
+    if sorted_weights is not None and sorted_weights.device != out.device:
+        raise ValueError("Native direct stage2 route weights must match the output device")
+
+    args = _Stage2Args()
+    args.inter_states_fp8 = a2.data_ptr()
+    args.w2_fp4 = w2.data_ptr()
+    args.a2_scale_e8m0 = a2_scale.data_ptr()
+    args.w2_scale_e8m0 = w2_scale.data_ptr()
+    args.sorted_token_ids = sorted_ids.data_ptr()
+    args.sorted_weights = None if sorted_weights is None else sorted_weights.data_ptr()
+    args.sorted_expert_ids = sorted_experts.data_ptr()
+    args.num_valid_ids = valid_ids.data_ptr()
+    args.out_bf16 = out.data_ptr()
+    args.stride_a_t = a2.stride(0)
+    args.stride_a_k = 0 if a2.ndim == 2 else a2.stride(1)
+    args.stride_w_e = w2.stride(0)
+    args.stride_w_h = w2.stride(1)
+    args.stride_a_scale_route = a2_scale.stride(0)
+    args.stride_w_scale_row = w2_scale.stride(0)
+    args.stride_o_t = out.stride(0)
+    args.token_num = out.shape[0]
+    args.topk = topk
+    args.num_experts = w2.shape[0]
+    args.model_dim = out.shape[1]
+    args.sorted_blocks = min(sorted_experts.numel(), out.shape[0] * topk)
+    args.sort_block_m = 64
+    args.a_scale_rows = a2_scale.shape[0]
+    args.route_out_fp8 = 0
+    args.k_tiles = 3
+    args.a_scale_words_per_row_pack = a2_scale.stride(0) * 8
+    args.w_scale_words_per_row_pack = w2_scale.stride(0) * 8
+    args.route_out_row_bytes = 0
+    status = native.prefill_direct_launch(
+        ctypes.byref(args), ctypes.c_void_p(torch.cuda.current_stream(out.device).cuda_stream)
+    )
+    if status:
+        detail = native.prefill_direct_error_string(status).decode("utf-8", errors="replace")
+        raise RuntimeError(f"Native BM64 direct stage2 launch failed: {status}: {detail}")
+    return out

+++ b/source/prepare.py
@@ -0,0 +1,141 @@
+# SPDX-License-Identifier: MIT
+"""Decode combines dynamic routing, group-32 FP8 quantization, E8M0 scale
+placement and atomic-output initialization in one kernel. Each program derives
+its route positions from current IDs without reading another program's writes.
+Prefill uses native sorting, token-once quantization and scale placement.
+Decode uses the candidate paired KWave4 BM16 stage1 and native BM16 stage2.
+Prefill uses the native BM64 FP8 route producer and parallel-slot FP32 reducer.
+
+The native-compatible route interface is parameterized by metadata.block_m:
+BM16 decode / BM64 prefill. Sorted int32 IDs encode (slot << 24) | token;
+BF16 atomic output [M,H] is zeroed before either GEMM executes. num_valid_ids
+is int32[2]: current padded sorted extent and live token count, device derived.
+Scale memory is E8M0[pad32(route capacity), pad8(ceil(H/32))], using the 32x8
+mx_scale_shuffle_idx layout independently of BM. Route capacity uses the native
+ceil((M*topk + E*BM - topk)/BM)*BM bound; no observed route count is baked in.
+Every invocation reads all current hidden states, route IDs and route weights.
+"""
+
+import importlib
+
+import torch
+
+from source.prepare_kernels import quantize_sort_a1
+
+from aiter import dtypes
+from aiter.ops.quant import per_1x32_mx_quant_hip, mxfp4_moe_sort_fwd
+
+_moe = importlib.import_module("aiter.fused_moe")
+
+
+def _supported(hidden_states, w1, w2, topk_ids, kw):
+    """Keep unrelated public-call variants on upstream's complete dispatcher."""
+    return (
+        hidden_states.shape[1] == 7168
+        and hidden_states.shape[0] in (64, 8192)
+        and hidden_states.dtype == dtypes.bf16
+        and hidden_states.is_contiguous()
+        and topk_ids.shape[1] == 6
+        and w1.shape[0] == 384
+        and w1.dtype == dtypes.fp4x2
+        and w2.dtype == dtypes.fp4x2
+        and getattr(w1, "is_shuffled", False)
+        and getattr(w2, "is_shuffled", False)
+        and kw.get("quant_type") == _moe.QuantType.per_1x32
+        and kw.get("activation", _moe.ActivationType.Silu) == _moe.ActivationType.Silu
+        and kw.get("gate_mode") == "interleave"
+        and not kw.get("doweight_stage1", False)
+        and not kw.get("hidden_pad", 0)
+        and not kw.get("intermediate_pad", 0)
+        and all(kw.get(k) is None for k in (
+            "expert_mask", "num_local_tokens", "a1_scale", "a2_scale", "bias1",
+            "bias2", "stage2_scatter", "shared_w1", "shared_w2",
+            "shared_w1_scale", "shared_w2_scale", "quant_type_a", "quant_dtype_a",
+            "quant_dtype_a2", "output",
+        ))
+        and kw.get("shared_expert_id", -1) == -1
+        and kw.get("clamp_shared", True)
+        and kw.get("dtype", hidden_states.dtype) in (None, hidden_states.dtype)
+    )
+
+
+
+def prepared_fused_moe(hidden_states, w1, w2, topk_weight, topk_ids, **kw):
+    if not _supported(hidden_states, w1, w2, topk_ids, kw):
+        return _moe.fused_moe(hidden_states, w1, w2, topk_weight, topk_ids, **kw)
+
+    M, topk = topk_ids.shape
+    E, H, I = _moe.get_inter_dim(w1.shape, w2.shape)
+    if (E, H, I) != (384, 7168, 384) or w1.shape[1] != 2 * I:
+        return _moe.fused_moe(hidden_states, w1, w2, topk_weight, topk_ids, **kw)
+    activation = kw.get("activation", _moe.ActivationType.Silu)
+    quant_type = kw["quant_type"]
+    gate_mode = _moe.GateMode(kw["gate_mode"])
+    beta, linear_beta, _ = _moe._normalize_mxfp4_activation_params(
+        activation, kw.get("beta"), kw.get("linear_beta"), kw.get("swiglu_limit")
+    )
+    metadata = _moe.get_2stage_cfgs(
+        _moe.get_padded_M(M), H, I, E, topk, hidden_states.dtype,
+        dtypes.fp8, w1.dtype, quant_type, True, activation, False, 0, 0,
+        True, gate_mode, is_ep=False, has_stage1_bias=False, has_stage2_bias=False,
+        situ_beta=beta, situ_linear_beta=linear_beta,
+        swiglu_limit=kw.get("swiglu_limit"), opus_weights_shuffled=True,
+        gate_up_interleave=getattr(w1, "gate_up_interleave", None),
+        input_dtype=hidden_states.dtype,
+    )
+    block_m = int(metadata.block_m)
+    if (metadata.run_1stage or metadata.output_aux or metadata.flat
+            or metadata.full_impl is not None
+            or kw.get("block_size_M") not in (None, 0, -1, block_m)):
+        return _moe.fused_moe(hidden_states, w1, w2, topk_weight, topk_ids, **kw)
+
+    if M == 64:
+        # The preparation and both consumers must agree on the route tile.
+        # Explicit caller overrides keep upstream's public dispatch semantics.
+        if kw.get("block_size_M") not in (None, 0):
+            return _moe.fused_moe(hidden_states, w1, w2, topk_weight, topk_ids, **kw)
+        from source.decode import _decode_metadata
+
+        metadata = _decode_metadata(metadata)
+        block_m = int(metadata.block_m)
+
+    accumulate = not _moe._stage2_runtime_uses_route_reduce(metadata.stage2, M, H)
+    if M == 64:
+        (sorted_ids, sorted_weights, sorted_expert_ids, num_valid_ids,
+         moe_out, a1, a1_scales) = quantize_sort_a1(
+            hidden_states, topk_ids, topk_weight, E, block_m, groups_per_program=64,
+        )
+    else:
+        sorted_ids, sorted_weights, sorted_expert_ids, num_valid_ids, moe_out = (
+            _moe.moe_sorting(
+                topk_ids, topk_weight, E, H, hidden_states.dtype, block_m,
+                dispatch_policy=kw.get("moe_sorting_dispatch_policy", 0),
+                accumulate=accumulate,
+            )
+        )
+        a1, token_scales = per_1x32_mx_quant_hip(
+            hidden_states, scale=None, quant_dtype=dtypes.fp8,
+            scale_type=dtypes.fp8_e8m0, shuffle=False,
+        )
+        a1_scales = mxfp4_moe_sort_fwd(
+            token_scales, sorted_ids, num_valid_ids, M, H,
+        )
+    stage2_override = None
+    if M == 8192:
+        from source.prefill import _route_stage2
+
+        stage2_override = _route_stage2
+    return _moe.fused_moe_2stages(
+        hidden_states, w1, w2, topk, sorted_ids, sorted_weights,
+        sorted_expert_ids, num_valid_ids, moe_out, True, block_m,
+        activation=activation, quant_type=quant_type, doweight_stage1=False,
+        q_dtype_a=dtypes.fp8, q_dtype_w=w1.dtype,
+        w1_scale=kw.get("w1_scale"), w2_scale=kw.get("w2_scale"),
+        topk_ids=topk_ids, topk_weights=topk_weight,
+        swiglu_limit=kw.get("swiglu_limit"), beta=kw.get("beta"),
+        linear_beta=kw.get("linear_beta"), gate_mode=gate_mode,
+        _metadata_transform=lambda _: metadata, routing_num_experts=E,
+        _stage2_override=stage2_override,
+        _stage1_extra_args={"swiglu_limit": kw.get("swiglu_limit")} if M == 64 else None,
+        prequantized_a1=a1, prequantized_a1_scale=a1_scales,
+    )

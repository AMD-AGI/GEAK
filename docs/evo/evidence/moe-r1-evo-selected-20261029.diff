@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: MIT
+"""Candidate-local combine kernels for the Opus packed FP8 route output."""
+
+import triton
+from triton.experimental import gluon
+from triton.experimental.gluon import language as gl
+
+
+@gluon.jit
+def _reduce_fp8_routes(
+    Route,
+    Out,
+    HIDDEN: gl.constexpr,
+    TOPK: gl.constexpr,
+    ROUTE_STRIDE: gl.constexpr,
+    OUT_STRIDE: gl.constexpr,
+    BLOCK_N: gl.constexpr,
+    SLOT_PAD: gl.constexpr,
+    NUM_WARPS: gl.constexpr,
+    PARALLEL_SLOTS: gl.constexpr,
+):
+    token = gl.program_id(0)
+    col_tile = gl.program_id(1)
+
+    # Eight adjacent columns share an E8M0 scale. Keep them in one lane so
+    # each lane reads a packed FP8 vector and reuses its scale. Distributing
+    # slots over waves makes independent route conversions run concurrently;
+    # the final cross-wave FP32 reduction owns each output element exactly once.
+    if PARALLEL_SLOTS:
+        layout: gl.constexpr = gl.BlockedLayout(
+            size_per_thread=[1, 8],
+            threads_per_warp=[1, 64],
+            warps_per_cta=[NUM_WARPS, 1],
+            order=[1, 0],
+        )
+    else:
+        layout: gl.constexpr = gl.BlockedLayout(
+            size_per_thread=[1, 8],
+            threads_per_warp=[1, 64],
+            warps_per_cta=[1, NUM_WARPS],
+            order=[1, 0],
+        )
+    slots = gl.arange(0, SLOT_PAD, layout=gl.SliceLayout(1, layout))
+    cols = col_tile * BLOCK_N + gl.arange(
+        0, BLOCK_N, layout=gl.SliceLayout(0, layout)
+    )
+    rows = token * TOPK + slots
+    valid = (slots[:, None] < TOPK) & (cols[None, :] < HIDDEN)
+    packed = gl.load(
+        Route + rows[:, None] * ROUTE_STRIDE + cols[None, :],
+        mask=valid,
+        other=0,
+        cache_modifier=".cg",
+    )
+    scales = gl.load(
+        Route + rows[:, None] * ROUTE_STRIDE + HIDDEN + cols[None, :] // 8,
+        mask=valid,
+        other=0,
+        cache_modifier=".cg",
+    )
+    values = packed.to(gl.float8e4nv, bitcast=True).to(gl.float32)
+    # This is the native reducer's exact E8M0 interpretation, including zero.
+    scale_f32 = (scales.to(gl.uint32) << 23).to(gl.float32, bitcast=True)
+    weighted_routes = values * scale_f32
+    combined = gl.sum(weighted_routes, axis=0)
+    gl.store(Out + token * OUT_STRIDE + cols, combined, mask=cols < HIDDEN)
+
+
+def reduce_fp8_routes(
+    route_output,
+    out,
+    *,
+    topk=6,
+    block_n=1024,
+    num_warps=4,
+    parallel_slots=True,
+):
+    """Fold all current packed route rows into the caller's BF16 output.
+
+    Opus has already applied the route weights before quantizing this buffer.
+    The function allocates no intermediate, and the launch fully overwrites
+    ``out`` on the current stream. The FP32 tree sum changes reduction order
+    relative to the native sequential reducer.
+    """
+    hidden = out.shape[1]
+    if route_output.ndim != 2 or route_output.shape != (
+        out.shape[0] * topk,
+        hidden + hidden // 8,
+    ):
+        raise ValueError("Expected Opus packed FP8 token-slot route output")
+    _reduce_fp8_routes[(out.shape[0], triton.cdiv(hidden, block_n))](
+        route_output,
+        out,
+        HIDDEN=hidden,
+        TOPK=topk,
+        ROUTE_STRIDE=route_output.stride(0),
+        OUT_STRIDE=out.stride(0),
+        BLOCK_N=block_n,
+        SLOT_PAD=triton.next_power_of_2(topk),
+        NUM_WARPS=num_warps,
+        PARALLEL_SLOTS=parallel_slots,
+        num_warps=num_warps,
+    )
+    return out

--- /dev/null
+++ b/source/decode.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: MIT
+"""Coherent 16-row A8W4 decode tiles with upstream per-call preparation."""
+
+from dataclasses import replace
+from functools import partial
+
+
+STAGE1 = "candidate_opus_moe1_t16_pair_kw4_m1_stream"
+STAGE2 = "opus_moe2_afp8_wfp4_atomic_t16x128x256_sbm16_cache_b3_ws2"
+BLOCK_M = 16
+
+
+def _decode_metadata(metadata):
+    from aiter.fused_moe import _flydsl_stage1_wrapper
+    from source.decode_stage1 import opus_a8w4_stage1_kw4_wrapper
+    from aiter.ops.opus.moe_stage2_a8w4 import (
+        opus_a8w4_stage2_wrapper,
+        parse_stage2_config,
+    )
+
+    # Four in-CTA K groups cover H7168's 56 K128 steps. Native static
+    # assertions preserve BM16, 32 output columns, stream+sparse epilogue.
+    assert getattr(metadata.stage1, "func", None) is _flydsl_stage1_wrapper
+    assert getattr(metadata.stage2, "func", None) is opus_a8w4_stage2_wrapper
+    assert metadata.fuse_quant == "fp8" and metadata.ksplit in (0, 1)
+    assert not metadata.skip_inter_quant
+    launch = parse_stage2_config({"kernelName2": STAGE2}, BLOCK_M)
+    assert launch.instance.block_m == BLOCK_M and launch.kernel_id == 2008
+    stage1_kwargs = {
+        "kernelName": STAGE1,
+        "activation": metadata.stage1.keywords["activation"],
+        "block_m": BLOCK_M,
+        "inter_dim_pad": 0,
+    }
+    stage2_kwargs = {
+        **metadata.stage2.keywords,
+        "kernelName": STAGE2,
+        "launch": launch,
+    }
+    # Sorting and both consumers share SBM16. The standard shuffled E8M0
+    # scale layout packs 32 rows; both kernels select the proper 16-row half.
+    # Opus handles I384 as three logical K128 steps and respects padded scales.
+    return replace(
+        metadata,
+        stage1=partial(opus_a8w4_stage1_kw4_wrapper, **stage1_kwargs),
+        stage2=partial(opus_a8w4_stage2_wrapper, **stage2_kwargs),
+        block_m=BLOCK_M,
+        route_bucket="",
+        expected_sorted_blocks=None,
+        min_sorted_blocks=None,
+        max_sorted_blocks=None,
+    )
+
+
+def fused_moe_decode(hidden_states, w1, w2, topk_weight, topk_ids, **kwargs):
+    from aiter import ActivationType, QuantType, dtypes
+    from aiter.fused_moe import _fused_moe_impl, fused_moe
+
+    # Only the documented FP8-activation/FP4-weight interleaved family uses
+    # this configuration. Other public options retain upstream validation.
+    if (
+        hidden_states.dtype != dtypes.bf16
+        or w1.dtype != dtypes.fp4x2
+        or kwargs.get("activation", ActivationType.Silu) != ActivationType.Silu
+        or kwargs.get("quant_type", QuantType.No) != QuantType.per_1x32
+        or kwargs.get("gate_mode") != "interleave"
+        or kwargs.get("doweight_stage1", False)
+        or kwargs.get("block_size_M") not in (None, 0)
+        or any(kwargs.get(key) is not None for key in (
+            "expert_mask", "num_local_tokens", "a1_scale", "a2_scale",
+            "bias1", "bias2", "stage2_scatter", "shared_w1", "shared_w2",
+            "shared_w1_scale", "shared_w2_scale", "quant_dtype_a", "quant_dtype_a2",
+        ))
+        or kwargs.get("shared_expert_id", -1) != -1
+        or not kwargs.get("clamp_shared", True)
+        or kwargs.get("hidden_pad", 0) != 0
+        or kwargs.get("intermediate_pad", 0) != 0
+    ):
+        return fused_moe(hidden_states, w1, w2, topk_weight, topk_ids, **kwargs)
+
+    options = dict(kwargs)
+    # These are public-wrapper options, absent from _fused_moe_impl.
+    for key in (
+        "splitk", "clamp_shared", "shared_expert_id", "shared_w1", "shared_w2",
+        "shared_w1_scale", "shared_w2_scale",
+    ):
+        options.pop(key, None)
+    options["block_size_M"] = BLOCK_M
+    # Upstream forwards this automatically only for its exact built-in
+    # wrapper identities. The local stage must receive the current caller's
+    # clamp as well; it is not inferred from the workload's observed value.
+    options["_stage1_extra_args"] = {"swiglu_limit": kwargs.get("swiglu_limit")}
+    return _fused_moe_impl(
+        hidden_states, w1, w2, topk_weight, topk_ids,
+        _metadata_transform=_decode_metadata,
+        _enforce_metadata_block_size=True,
+        **options,
+    )
diff --git a/source/decode_stage1.py b/source/decode_stage1.py
new file mode 100644
index 0000000000000000000000000000000000000000..ff8d11680c94f99db69d877b4831864538d37e29
--- /dev/null
+++ b/source/decode_stage1.py
@@ -0,0 +1,213 @@
+# SPDX-License-Identifier: MIT
+"""KWave4 paired Opus stage1 with cross-pair staging and external build cache.
+
+The kernel keeps the KWave4 policy and stages the next A/B/scale pair before
+consuming the current pair; MFMA order and the common epilogue stay fixed.
+Compilation is lazy, so the admitted Arena action owns compilation and launches.
+No input-dependent state survives a call. Build outputs stay beside the workspace.
+"""
+
+import ctypes
+from functools import lru_cache
+import hashlib
+import json
+import math
+from pathlib import Path
+import subprocess
+import sys
+
+
+class _Kargs(ctypes.Structure):
+    _fields_ = [
+        (name, ctypes.c_void_p) for name in (
+            "hidden_fp8", "w1_fp4", "hidden_scale_e8m0", "w1_scale_e8m0",
+            "w1_bias", "sorted_token_ids", "sorted_expert_ids", "num_valid_ids",
+            "inter_states_fp8", "inter_states_scale_e8m0",
+        )
+    ] + [
+        (name, ctypes.c_int64) for name in (
+            "stride_hidden_t", "stride_w1_e", "stride_w1_bias_e", "stride_out_t",
+            "stride_out_k", "stride_out_scale_route",
+        )
+    ] + [
+        (name, ctypes.c_int32) for name in (
+            "token_num", "topk", "num_experts", "inter_dim", "hidden_scale_cols",
+            "k_steps", "activation",
+        )
+    ] + [
+        (name, ctypes.c_float) for name in (
+            "swiglu_limit", "situ_beta", "situ_linear_beta",
+        )
+    ] + [
+        (name, ctypes.c_uint32) for name in (
+            "hidden_size_bytes", "w1_size_bytes", "hidden_scale_size_bytes",
+            "w1_scale_size_bytes", "out_size_bytes", "out_scale_size_bytes",
+        )
+    ]
+
+
+def _run_build(argv, build_dir, stem):
+    result = subprocess.run(argv, cwd=build_dir, capture_output=True, text=True)
+    (build_dir / (stem + ".stdout")).write_text(result.stdout)
+    (build_dir / (stem + ".stderr")).write_text(result.stderr)
+    if result.returncode:
+        raise RuntimeError(
+            f"Decode stage1 {stem} failed ({result.returncode}): "
+            f"{result.stderr[-6000:]}"
+        )
+
+
+@lru_cache(maxsize=1)
+def _library():
+    import aiter
+
+    source_dir = Path(__file__).resolve().parent
+    native_source = source_dir / "decode_stage1" / "launch.cu"
+    csrc = Path(aiter.__file__).resolve().parent.parent / "csrc"
+    stage1 = csrc / "opus_moe" / "include" / "gfx950" / "a8w4" / "stage1"
+    flags = [
+        "-shared", "-fPIC", "-O3", "-std=c++20", "--offload-arch=gfx950",
+        "-fgpu-flush-denormals-to-zero", "-fno-offload-uniform-block",
+        "-mllvm", "--amdgpu-kernarg-preload-count=32",
+        "-mllvm", "--lsr-drop-solution=1",
+        "-mllvm", "-amdgpu-early-inline-all=true",
+        "-mllvm", "-amdgpu-function-calls=false",
+        "-mllvm", "--amdgpu-mfma-vgpr-form",
+        "-mllvm", "-enable-post-misched=1",
+        "-D__Float4_e2m1fn_x2", "-DENABLE_CK=0",
+    ]
+    inputs = [
+        Path(__file__).resolve(), native_source,
+        source_dir / "decode_stage1" / "pair_full_prefetch.cuh",
+        source_dir / "decode_stage1" / "pair_pipeline.cuh",
+        csrc / "opus_moe" / "gen_instances.py",
+        csrc / "opus_moe" / "opus_moe_common.py",
+        csrc / "opus_moe" / "include" / "opus_moe_common.cuh",
+        csrc / "include" / "aiter_enum.h", csrc / "include" / "mx_quant_utils.h",
+        stage1 / "opus_moe_stage1_a8w4_traits_gfx950.cuh",
+        stage1 / "opus_moe_stage1_a8w4_pipeline_common_gfx950.cuh",
+        stage1 / "opus_moe_stage1_a8w4_pipeline_pair_kwave_gfx950.cuh",
+    ]
+    inputs.extend(sorted((csrc / "include" / "opus").glob("*.hpp")))
+    key = hashlib.sha256(json.dumps(flags).encode())
+    for path in inputs:
+        key.update(str(path.relative_to(csrc) if path.is_relative_to(csrc) else path.name).encode())
+        key.update(path.read_bytes())
+    build_dir = source_dir.parent.parent / "decode_stage1_build" / key.hexdigest()
+    build_dir.mkdir(parents=True, exist_ok=True)
+    library_path = build_dir / "decode_stage1.so"
+    if not library_path.is_file():
+        # The protected generator only writes metadata/device shards to this
+        # dedicated build directory. Only our one specialization is compiled.
+        generator = [
+            sys.executable, "-B", str(csrc / "opus_moe" / "gen_instances.py"),
+            "--working_path", str(build_dir),
+        ]
+        _run_build(generator, build_dir, "generate")
+        temporary_library = build_dir / "decode_stage1.building.so"
+        command = [
+            "/opt/rocm/bin/hipcc", *flags,
+            "-I" + str(csrc / "include"),
+            "-I" + str(csrc / "opus_moe" / "include"),
+            "-I" + str(csrc / "opus_gemm" / "include"),
+            "-I" + str(build_dir), str(native_source), "-o", str(temporary_library),
+        ]
+        (build_dir / "build_command.json").write_text(json.dumps(command, indent=2))
+        _run_build(command, build_dir, "compile")
+        temporary_library.replace(library_path)
+    lib = ctypes.CDLL(str(library_path))
+    lib.decode_stage1_abi_size.argtypes = []
+    lib.decode_stage1_abi_size.restype = ctypes.c_size_t
+    lib.decode_stage1_abi_offset.argtypes = [ctypes.c_int]
+    lib.decode_stage1_abi_offset.restype = ctypes.c_size_t
+    if lib.decode_stage1_abi_size() != ctypes.sizeof(_Kargs):
+        raise RuntimeError("Decode stage1 native Kargs size mismatch")
+    for index, (name, _) in enumerate(_Kargs._fields_):
+        if lib.decode_stage1_abi_offset(index) != getattr(_Kargs, name).offset:
+            raise RuntimeError(f"Decode stage1 native Kargs offset mismatch: {name}")
+    lib.decode_stage1_launch.argtypes = [ctypes.POINTER(_Kargs), ctypes.c_int, ctypes.c_void_p]
+    lib.decode_stage1_launch.restype = ctypes.c_int
+    return lib
+
+
+def _extent_bytes(tensor):
+    extent = tensor.shape[0] * tensor.stride(0) * tensor.element_size()
+    if not 0 < extent <= 0xFFFFFFFF:
+        raise ValueError("Decode stage1 tensor exceeds native buffer extent")
+    return extent
+
+
+def opus_a8w4_stage1_kw4_wrapper(
+    hidden_states, w1, w2, sorted_token_ids, sorted_expert_ids, num_valid_ids,
+    out, topk, activation, kernelName="", block_m=0, w1_scale=None,
+    a1_scale=None, sorted_weights=None, bias1=None, swiglu_limit=None,
+    situ_beta=4.0, situ_linear_beta=25.0, inter_dim_pad=0,
+    output_sorted=False, **_kwargs,
+):
+    """Common stage1 ABI; caller must forward its current finite SiLU clamp."""
+    import torch
+    from aiter import ActivationType, dtypes
+
+    del w2, kernelName, _kwargs
+    activation_value = int(getattr(activation, "value", activation))
+    if (
+        tuple(hidden_states.shape) != (64, 7168)
+        or hidden_states.dtype != dtypes.fp8
+        or tuple(w1.shape) != (384, 768, 3584)
+        or w1.dtype != dtypes.fp4x2
+        or int(topk) != 6 or int(block_m) != 16 or int(inter_dim_pad) != 0
+        or activation_value != ActivationType.Silu.value
+        or output_sorted or sorted_weights is not None or bias1 is not None
+    ):
+        raise ValueError("KWave4 stage1 requires the bound BM16 A8W4 decode family")
+    limit = float(swiglu_limit) if swiglu_limit else math.inf
+    if not limit > 0:
+        raise ValueError("KWave4 stage1 requires a positive SiLU clamp")
+    if a1_scale is None or w1_scale is None:
+        raise ValueError("KWave4 stage1 requires sorted E8M0 A1/W1 scales")
+    tensors = (hidden_states, w1, a1_scale, w1_scale, sorted_token_ids,
+               sorted_expert_ids, num_valid_ids)
+    for tensor in tensors:
+        if not tensor.is_cuda or tensor.device != hidden_states.device or not tensor.is_contiguous():
+            raise ValueError("KWave4 stage1 requires contiguous tensors on one GPU")
+    if (
+        a1_scale.dtype != dtypes.fp8_e8m0 or a1_scale.ndim != 2
+        or a1_scale.shape[1] != 224
+        or w1_scale.dtype != dtypes.fp8_e8m0
+        or tuple(w1_scale.shape) != (384 * 768, 224)
+        or any(t.dtype != torch.int32 for t in (sorted_token_ids, sorted_expert_ids, num_valid_ids))
+        or sorted_token_ids.ndim != 1 or sorted_expert_ids.ndim != 1
+        or num_valid_ids.numel() < 1
+    ):
+        raise ValueError("KWave4 stage1 scale or routing layout mismatch")
+    sorted_blocks = min(sorted_expert_ids.numel(), 64 * 6)
+    if sorted_blocks <= 0 or sorted_token_ids.numel() < sorted_blocks * 16:
+        raise ValueError("KWave4 stage1 routing capacity is insufficient")
+    if a1_scale.shape[0] < sorted_blocks * 16:
+        raise ValueError("KWave4 stage1 A1 scales do not cover the launch")
+    if out is None:
+        out = torch.empty((64, 6, 384), dtype=dtypes.fp8, device=hidden_states.device)
+    if (tuple(out.shape) != (64, 6, 384) or out.dtype != dtypes.fp8
+            or out.device != hidden_states.device or not out.is_contiguous()):
+        raise ValueError("KWave4 stage1 output layout mismatch")
+    sorted_size = max(sorted_token_ids.numel(), sorted_expert_ids.numel() * 16)
+    out_scale = torch.empty(
+        ((sorted_size + 255) // 256 * 256, 16),
+        dtype=dtypes.fp8_e8m0, device=hidden_states.device,
+    )
+    args = _Kargs(
+        hidden_states.data_ptr(), w1.data_ptr(), a1_scale.data_ptr(), w1_scale.data_ptr(),
+        None, sorted_token_ids.data_ptr(), sorted_expert_ids.data_ptr(), num_valid_ids.data_ptr(),
+        out.data_ptr(), out_scale.data_ptr(),
+        hidden_states.stride(0), w1.stride(0), 0, out.stride(0), out.stride(1), out_scale.stride(0),
+        64, 6, 384, 384, 224, 56, activation_value, limit, float(situ_beta), float(situ_linear_beta),
+        _extent_bytes(hidden_states), _extent_bytes(w1), _extent_bytes(a1_scale),
+        _extent_bytes(w1_scale), _extent_bytes(out), _extent_bytes(out_scale),
+    )
+    status = _library().decode_stage1_launch(
+        ctypes.byref(args), int(sorted_blocks),
+        ctypes.c_void_p(torch.cuda.current_stream(hidden_states.device).cuda_stream),
+    )
+    if status:
+        raise RuntimeError(f"KWave4 stage1 HIP launch failed: {status}")
+    return out, out_scale

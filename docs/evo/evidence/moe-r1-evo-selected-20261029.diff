@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: MIT
+// Candidate-local direct-output instantiation of the pinned AITER Opus pipeline.
+#include <hip/hip_runtime.h>
+#include <cstddef>
+#include <type_traits>
+
+#include "gfx950/a8w4/opus_moe_pipeline_stage2_a8w4_decode_main_gfx950.cuh"
+
+// Retain the selected prefill producer's BM64, four-wave, paired-load schedule.
+// Only its output ownership changes from token-slot FP8 to token BF16 atomics.
+struct PrefillDirectTraits
+    : OpusMoeStage2A8W4DecodeShape<64, 256, false, false, 256, 4, 0, 0, 2, 1>
+{
+    static constexpr bool DIRECT_ATOMIC_OUT = true;
+};
+
+#if defined(__HIP_DEVICE_COMPILE__) && defined(__gfx950__)
+// The generic atomic path uses natural block order. Keep the original producer's
+// XCD swizzle so that the experiment isolates the output/combine ownership.
+template<>
+inline __device__ void opus_moe_stage2_a8w4_decode_make_tile<PrefillDirectTraits>(
+    const opus_moe_stage2_a8w4_kargs& kargs,
+    int& sorted_rows,
+    int& route_base,
+    int& col_base)
+{
+    sorted_rows = kargs.num_valid_ids[0];
+    const int num_tiles_n = kargs.model_dim / PrefillDirectTraits::B_N;
+    const int wgid = static_cast<int>(blockIdx.y) * num_tiles_n +
+                     static_cast<int>(blockIdx.x);
+    int tile_m_id;
+    int tile_n_id;
+    opus_moe_stage2_a8w4_decode_tile_ids<PrefillDirectTraits>(
+        wgid, kargs.sorted_blocks, num_tiles_n, tile_m_id, tile_n_id);
+    route_base = tile_m_id * PrefillDirectTraits::ROUTE_M_STRIDE;
+    col_base = tile_n_id * PrefillDirectTraits::B_N;
+}
+#endif
+
+static_assert(sizeof(opus_moe_stage2_a8w4_kargs) == 184,
+              "Python/native stage2 argument layout mismatch");
+static_assert(PrefillDirectTraits::NUM_XCD == 8);
+static_assert(PrefillDirectTraits::SWIZZLE_C == 32);
+
+
+using Kargs = opus_moe_stage2_a8w4_kargs;
+static_assert(std::is_standard_layout_v<Kargs>);
+static_assert(offsetof(Kargs, inter_states_fp8) == 0);
+static_assert(offsetof(Kargs, w2_fp4) == 8);
+static_assert(offsetof(Kargs, a2_scale_e8m0) == 16);
+static_assert(offsetof(Kargs, w2_scale_e8m0) == 24);
+static_assert(offsetof(Kargs, sorted_token_ids) == 32);
+static_assert(offsetof(Kargs, sorted_weights) == 40);
+static_assert(offsetof(Kargs, sorted_expert_ids) == 48);
+static_assert(offsetof(Kargs, num_valid_ids) == 56);
+static_assert(offsetof(Kargs, out_bf16) == 64);
+static_assert(offsetof(Kargs, stride_a_t) == 72);
+static_assert(offsetof(Kargs, stride_a_k) == 80);
+static_assert(offsetof(Kargs, stride_w_e) == 88);
+static_assert(offsetof(Kargs, stride_w_h) == 96);
+static_assert(offsetof(Kargs, stride_a_scale_route) == 104);
+static_assert(offsetof(Kargs, stride_w_scale_row) == 112);
+static_assert(offsetof(Kargs, stride_o_t) == 120);
+static_assert(offsetof(Kargs, token_num) == 128);
+static_assert(offsetof(Kargs, topk) == 132);
+static_assert(offsetof(Kargs, num_experts) == 136);
+static_assert(offsetof(Kargs, model_dim) == 140);
+static_assert(offsetof(Kargs, sorted_blocks) == 144);
+static_assert(offsetof(Kargs, sort_block_m) == 148);
+static_assert(offsetof(Kargs, a_scale_rows) == 152);
+static_assert(offsetof(Kargs, route_out_fp8) == 156);
+static_assert(offsetof(Kargs, k_tiles) == 160);
+static_assert(offsetof(Kargs, a_scale_words_per_row_pack) == 164);
+static_assert(offsetof(Kargs, w_scale_words_per_row_pack) == 168);
+static_assert(offsetof(Kargs, route_out_row_bytes) == 176);
+extern "C" size_t prefill_direct_abi_size() { return sizeof(Kargs); }
+extern "C" size_t prefill_direct_abi_offset(int field)
+{
+    constexpr size_t offsets[] = {
+        offsetof(Kargs, inter_states_fp8),
+        offsetof(Kargs, w2_fp4),
+        offsetof(Kargs, a2_scale_e8m0),
+        offsetof(Kargs, w2_scale_e8m0),
+        offsetof(Kargs, sorted_token_ids),
+        offsetof(Kargs, sorted_weights),
+        offsetof(Kargs, sorted_expert_ids),
+        offsetof(Kargs, num_valid_ids),
+        offsetof(Kargs, out_bf16),
+        offsetof(Kargs, stride_a_t),
+        offsetof(Kargs, stride_a_k),
+        offsetof(Kargs, stride_w_e),
+        offsetof(Kargs, stride_w_h),
+        offsetof(Kargs, stride_a_scale_route),
+        offsetof(Kargs, stride_w_scale_row),
+        offsetof(Kargs, stride_o_t),
+        offsetof(Kargs, token_num),
+        offsetof(Kargs, topk),
+        offsetof(Kargs, num_experts),
+        offsetof(Kargs, model_dim),
+        offsetof(Kargs, sorted_blocks),
+        offsetof(Kargs, sort_block_m),
+        offsetof(Kargs, a_scale_rows),
+        offsetof(Kargs, route_out_fp8),
+        offsetof(Kargs, k_tiles),
+        offsetof(Kargs, a_scale_words_per_row_pack),
+        offsetof(Kargs, w_scale_words_per_row_pack),
+        offsetof(Kargs, route_out_row_bytes),
+    };
+    return field >= 0 && field < 28 ? offsets[field] : size_t(-1);
+}
+
+extern "C" int prefill_direct_launch(const opus_moe_stage2_a8w4_kargs* host_kargs,
+                                     hipStream_t stream)
+{
+    if(host_kargs == nullptr)
+        return static_cast<int>(hipErrorInvalidValue);
+    const auto kargs = *host_kargs;
+    if(kargs.token_num != 8192 || kargs.topk != 6 || kargs.num_experts != 384 ||
+       kargs.model_dim != 7168 || kargs.sort_block_m != 64 || kargs.k_tiles != 3 ||
+       kargs.stride_o_t != kargs.model_dim ||
+       (kargs.stride_a_k != 0 && kargs.stride_a_k != 384) ||
+       kargs.sorted_blocks <= 0)
+        return static_cast<int>(hipErrorInvalidValue);
+
+    // Fresh initialization belongs to this invocation and precedes every route
+    // producer on the same stream. No other stream or cached tensor is involved.
+    const auto output_bytes = static_cast<size_t>(kargs.token_num) *
+                              static_cast<size_t>(kargs.stride_o_t) *
+                              sizeof(hip_bfloat16);
+    const hipError_t init_status = hipMemsetAsync(kargs.out_bf16, 0, output_bytes, stream);
+    if(init_status != hipSuccess)
+        return static_cast<int>(init_status);
+    const dim3 grid(kargs.model_dim / PrefillDirectTraits::B_N, kargs.sorted_blocks);
+    const dim3 block(PrefillDirectTraits::BLOCK_SIZE);
+    opus_moe_stage2_a8w4_decode_kernel_gfx950<PrefillDirectTraits>
+        <<<grid, block, 0, stream>>>(kargs);
+    return static_cast<int>(hipGetLastError());
+}
+
+extern "C" const char* prefill_direct_error_string(int status)
+{
+    return hipGetErrorString(static_cast<hipError_t>(status));
+}

@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: MIT
+// Candidate-local specialization of the pinned Opus paired A8W4 stage1.
+#include <hip/hip_runtime.h>
+#include <cstddef>
+#include <cstdint>
+#include <type_traits>
+#include "pair_pipeline.cuh"
+
+using namespace opus_moe::stage1_a8w4;
+using Kargs = OpusMoeStage1A8W4Kargs;
+using Policy = OpusMoeStage1A8W4Policy<false, 4, 1, 1, 256, true, false, true>;
+using Shape = OpusMoeStage1A8W4Shape<16, 384, Policy>;
+
+static_assert(Shape::BLOCK_SIZE == 512);
+static_assert(Shape::OUTPUT_COLS_PER_TILE == 32);
+static_assert(Shape::K_WAVE == 4 && Shape::MIN_BLOCKS_PER_CU == 1);
+static_assert(Shape::WEIGHT_LOAD_STREAM && Shape::SPARSE_EPILOGUE);
+static_assert(!Shape::B_K1_LEAD);
+static_assert(Shape::KWAVE_REDUCE_BYTES == 16384);
+static_assert(Shape::SHARED_SCRATCH_BYTES == 20480);
+static_assert(std::is_standard_layout_v<Kargs> && sizeof(Kargs) == 192);
+
+#define ABI_FIELDS(F) \
+    F(hidden_fp8, 0) \
+    F(w1_fp4, 8) \
+    F(hidden_scale_e8m0, 16) \
+    F(w1_scale_e8m0, 24) \
+    F(w1_bias, 32) \
+    F(sorted_token_ids, 40) \
+    F(sorted_expert_ids, 48) \
+    F(num_valid_ids, 56) \
+    F(inter_states_fp8, 64) \
+    F(inter_states_scale_e8m0, 72) \
+    F(stride_hidden_t, 80) \
+    F(stride_w1_e, 88) \
+    F(stride_w1_bias_e, 96) \
+    F(stride_out_t, 104) \
+    F(stride_out_k, 112) \
+    F(stride_out_scale_route, 120) \
+    F(token_num, 128) \
+    F(topk, 132) \
+    F(num_experts, 136) \
+    F(inter_dim, 140) \
+    F(hidden_scale_cols, 144) \
+    F(k_steps, 148) \
+    F(activation, 152) \
+    F(swiglu_limit, 156) \
+    F(situ_beta, 160) \
+    F(situ_linear_beta, 164) \
+    F(hidden_size_bytes, 168) \
+    F(w1_size_bytes, 172) \
+    F(hidden_scale_size_bytes, 176) \
+    F(w1_scale_size_bytes, 180) \
+    F(out_size_bytes, 184) \
+    F(out_scale_size_bytes, 188)
+
+#define CHECK_ABI(name, offset) static_assert(offsetof(Kargs, name) == offset);
+ABI_FIELDS(CHECK_ABI)
+#undef CHECK_ABI
+
+extern "C" size_t decode_stage1_abi_size() { return sizeof(Kargs); }
+extern "C" size_t decode_stage1_abi_offset(int field)
+{
+#define FIELD_OFFSET(name, offset) offsetof(Kargs, name),
+    constexpr size_t offsets[] = {ABI_FIELDS(FIELD_OFFSET)};
+#undef FIELD_OFFSET
+    return field >= 0 && field < 32 ? offsets[field] : size_t(-1);
+}
+
+extern "C" int decode_stage1_launch(const Kargs* args, int sorted_blocks, void* stream)
+{
+    if(args == nullptr || args->token_num != 64 || args->topk != 6 ||
+       args->num_experts != 384 || args->inter_dim != 384 ||
+       args->hidden_scale_cols != 224 || args->k_steps != 56 ||
+       args->activation != ActivationType::Silu || !(args->swiglu_limit > 0) ||
+       sorted_blocks <= 0 || sorted_blocks > 384)
+        return static_cast<int>(hipErrorInvalidValue);
+    const dim3 grid(384 / Shape::OUTPUT_COLS_PER_TILE, sorted_blocks);
+    const dim3 block(Shape::BLOCK_SIZE);
+    pipeline_pair_pipeline::opus_moe_stage1_a8w4_kernel_pair_pipeline_gfx950<Shape>
+        <<<grid, block, 0, reinterpret_cast<hipStream_t>(stream)>>>(*args);
+    return static_cast<int>(hipGetLastError());
+}
diff --git a/source/decode_stage1/pair_full_prefetch.cuh b/source/decode_stage1/pair_full_prefetch.cuh

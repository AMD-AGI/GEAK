+# SPDX-License-Identifier: MIT
+"""Prefill-only stage-2 ownership experiments; upstream preparation is retained."""
+
+from aiter.fused_moe import _fused_moe_impl
+from aiter.ops.opus.moe_stage2_a8w4 import opus_moe_stage2_a8w4_decode_fwd
+from .prefill_kernels import reduce_fp8_routes
+from .prefill_native import native_direct_stage2
+
+
+def _route_stage2(*, ordinary_stage2, stage2_args, stage2_kwargs):
+    a2, _w1, w2, sorted_ids, sorted_experts, valid_ids, out, topk = stage2_args
+    assert stage2_kwargs["block_m"] == 64
+    routes = opus_moe_stage2_a8w4_decode_fwd(
+        a2, w2, stage2_kwargs["a2_scale"], stage2_kwargs["w2_scale"],
+        sorted_ids, stage2_kwargs["sorted_weights"], sorted_experts, valid_ids,
+        token_num=out.shape[0], topk=topk, block_m=64, kernel_id=2013,
+        return_per_slot=True, route_out_dtype="fp8",
+        inter_dim_pad=stage2_kwargs.get("inter_dim_pad", 0),
+    )
+    return reduce_fp8_routes(routes, out, topk=topk, block_n=1024, num_warps=4)
+
+
+def _direct_stage2(*, ordinary_stage2, stage2_args, stage2_kwargs):
+    a2, _w1, w2, sorted_ids, sorted_experts, valid_ids, out, topk = stage2_args
+    # A BM64 sorted block is two homogeneous BM32 blocks. Absolute sorted-row
+    # A2 and scale addresses stay unchanged; only the expert-block map expands.
+    assert stage2_kwargs["block_m"] == 64
+    expert_blocks32 = sorted_experts.repeat_interleave(2)
+    # The upstream route-output path does not initialize this destination.
+    # Initialization must precede all six routes' BF16 atomic additions.
+    out.zero_()
+    return opus_moe_stage2_a8w4_decode_fwd(
+        a2, w2, stage2_kwargs["a2_scale"], stage2_kwargs["w2_scale"],
+        sorted_ids, stage2_kwargs["sorted_weights"], expert_blocks32, valid_ids,
+        out=out, token_num=out.shape[0], topk=topk,
+        block_m=32, kernel_id=2005,
+        inter_dim_pad=stage2_kwargs.get("inter_dim_pad", 0),
+    )
+
+
+def prefill_moe(hidden_states, w1, w2, topk_weight, topk_ids, **kwargs):
+    # These are the same enum conversions performed by the public facade.
+    for name in ("activation", "quant_type", "quant_type_a"):
+        value = kwargs.get(name)
+        if value is not None and hasattr(value, "value"):
+            kwargs[name] = value.value
+    return _fused_moe_impl(
+        hidden_states, w1, w2, topk_weight, topk_ids,
+        _stage2_override=native_direct_stage2, **kwargs,
+    )

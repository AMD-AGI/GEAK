index 0000000000000000000000000000000000000000..4ea0abc738ed6ffb75c3232025332fcbb00c892e
--- /dev/null
+++ b/source/prepare_kernels.py
@@ -0,0 +1,438 @@
+# SPDX-License-Identifier: MIT
+"""Token-once MXFP8 A1 quantization with native sorted-scale placement.
+
+The native Opus sorter can produce ``reverse_sorted[token * topk + slot]``,
+the row at which that route occurs in its BM-padded sorted output, with -1
+for an excluded route.  The sorter must run before this kernel on the current
+stream.  Each program owns a distinct (token, group-of-32-features) range;
+each quantized activation byte has one writer, and each valid sorted scale
+byte has one writer.  No cross-program synchronization is required.
+
+The scale layout is exactly ``mx_scale_shuffle_idx`` in upstream
+``csrc/include/mx_quant_utils.h``.  Its tile is 32 rows x 8 scale columns,
+independent of the route sorter's BM (currently 32 decode / 64 prefill).
+
+By default only valid route scale bytes are written, matching upstream's
+small-M fused helper: ``ops/quant.py:fused_dynamic_mx_quant_moe_sort`` allocates
+the scale with ``torch.empty`` and ``fused_mx_quant_moe_sort_kernel`` in
+``csrc/kernels/quant_kernels.cu`` breaks before its scale write when a sorted
+token is the padding sentinel.  Padding therefore has no defined native
+value.  For Opus stage1, ``load_routes_stage1`` rejects sentinel token/slot
+indices and the quantizing epilogue returns before writing invalid routes
+(``opus_moe_stage1_a8w4_pipeline_common_gfx950.cuh``).  Its ``select_sfa_stage1``
+also substitutes ``kNoScaleWord`` outside the group-split specialization.
+``initialize_padding=True`` optionally writes neutral E8M0 127 to only
+sentinel/out-of-extent rows and padded columns in the same launch.  These
+writes are disjoint from the reverse-index scatters, so they cannot race.
+
+This module performs no import-time device operation or input preparation.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+from aiter import dtypes
+
+
+@triton.jit
+def _mx_scale_offset(row, col, SCALE_COLS_PAD: tl.constexpr):
+    return (
+        (row // 32 * SCALE_COLS_PAD) * 32
+        + (col // 8) * 256
+        + (col % 4) * 64
+        + (row % 16) * 4
+        + ((col % 8) // 4) * 2
+        + ((row % 32) // 16)
+    )
+
+
+@triton.jit
+def _token_once_quant_scatter(
+    X,
+    REVERSE,
+    SORTED_IDS,
+    NUM_VALID,
+    A1,
+    SORTED_SCALE,
+    M: tl.constexpr,
+    H: tl.constexpr,
+    TOPK: tl.constexpr,
+    STRIDE_M: tl.constexpr,
+    STRIDE_H: tl.constexpr,
+    SCALE_COLS: tl.constexpr,
+    SCALE_COLS_PAD: tl.constexpr,
+    SORTED_CAPACITY: tl.constexpr,
+    SCALE_ROWS_PAD: tl.constexpr,
+    GROUPS_PER_PROGRAM: tl.constexpr,
+    GROUP_TILES: tl.constexpr,
+    QUANT_PROGRAMS: tl.constexpr,
+    INITIALIZE_PADDING: tl.constexpr,
+    PAD_BLOCK: tl.constexpr,
+):
+    pid = tl.program_id(0)
+    if pid < QUANT_PROGRAMS:
+        token = pid // GROUP_TILES
+        group = (pid % GROUP_TILES) * GROUPS_PER_PROGRAM + tl.arange(
+            0, GROUPS_PER_PROGRAM
+        )
+        feature = group[:, None] * 32 + tl.arange(0, 32)[None, :]
+        x = tl.load(
+            X + token * STRIDE_M + feature * STRIDE_H,
+            mask=feature < H,
+            other=0.0,
+        ).to(tl.float32)
+
+        # Same f32 bit rule as fp_f32_to_e8m0_scale<RoundUp, FP8_E4M3>.
+        # In particular, this is RCEIL(amax / 448), not ceil(amax) / 256.
+        # The native amax reduction starts at the shared floor 1e-10f.
+        amax = tl.maximum(tl.max(tl.abs(x), axis=1), 1.0e-10)
+        ratio_bits = (amax * (1.0 / 448.0)).to(tl.uint32, bitcast=True)
+        exponent = (ratio_bits >> 23) & 255
+        exponent += ((exponent < 255) & ((ratio_bits & 0x7FFFFF) != 0)).to(
+            tl.uint32
+        )
+        dequant_scale = (exponent << 23).to(tl.float32, bitcast=True)
+        # Match scaled_quant_vgpr_impl's v_rcp_f32 rather than introducing a
+        # different division approximation.  Normal power-of-two scales have
+        # exactly representable reciprocals.
+        inverse_scale = tl.inline_asm_elementwise(
+            "v_rcp_f32 $0, $1;",
+            constraints="=v,v",
+            args=[dequant_scale],
+            dtype=tl.float32,
+            is_pure=True,
+            pack=1,
+        )
+        scaled = x * inverse_scale[:, None]
+        scaled = tl.minimum(tl.maximum(scaled, -448.0), 448.0)
+        q = scaled.to(tl.float8e4nv, fp_downcast_rounding="rtne")
+        tl.store(A1 + token * H + feature, q, mask=feature < H)
+
+        extent = tl.load(NUM_VALID)
+        for slot in tl.static_range(TOPK):
+            row = tl.load(REVERSE + token * TOPK + slot)
+            scale_offset = _mx_scale_offset(row, group, SCALE_COLS_PAD)
+            tl.store(
+                SORTED_SCALE + scale_offset,
+                exponent.to(tl.uint8),
+                mask=(row >= 0)
+                & (row < extent)
+                & (row < SORTED_CAPACITY)
+                & (group < SCALE_COLS),
+            )
+    elif INITIALIZE_PADDING:
+        # Invert the physical swizzle to identify only unused bytes.  The
+        # reverse-scatter side writes real token rows and logical columns;
+        # this side writes their complement, even within the same dword.
+        offset = (pid - QUANT_PROGRAMS) * PAD_BLOCK + tl.arange(0, PAD_BLOCK)
+        tile = offset // (32 * SCALE_COLS_PAD)
+        within = offset % (32 * SCALE_COLS_PAD)
+        quad = within % 256
+        row = tile * 32 + ((quad % 64) // 4) + (quad % 2) * 16
+        col = (within // 256) * 8 + quad // 64 + ((quad % 4) // 2) * 4
+        extent = tl.load(NUM_VALID)
+        token_info = tl.load(
+            SORTED_IDS + row,
+            mask=(row < extent) & (row < SORTED_CAPACITY),
+            other=M,
+        )
+        padding = (
+            (row >= extent)
+            | (row >= SORTED_CAPACITY)
+            | ((token_info & 0xFFFFFF) >= M)
+            | (col >= SCALE_COLS)
+        )
+        tl.store(
+            SORTED_SCALE + offset,
+            127,
+            mask=(offset < SCALE_ROWS_PAD * SCALE_COLS_PAD) & padding,
+        )
+
+
+def quantize_a1_scatter(
+    hidden_states,
+    reverse_sorted,
+    sorted_ids,
+    num_valid_ids,
+    topk,
+    block_m,
+    *,
+    groups_per_program=32,
+    initialize_padding=False,
+):
+    """Return token-major FP8 A1 and swizzled sorted E8M0 scales.
+
+    ``reverse_sorted`` must describe this invocation's native sorting result.
+    The caller continues to own all original sorted buffers and output zero
+    initialization; this operation neither changes nor replaces those buffers.
+    All bounds here use tensor metadata, while live route extent is read only
+    by the device kernel.  ``block_m`` describes the preserved GEMM interface;
+    the independent scale-layout tile remains 32x8 for any supported BM.
+    """
+    m, h = hidden_states.shape
+    if hidden_states.dtype != dtypes.bf16 or h % 32:
+        raise ValueError("A1 scatter expects BF16 rows with H divisible by 32")
+    if block_m <= 0 or block_m % 16:
+        raise ValueError("route block_m must be a positive multiple of 16")
+    if groups_per_program <= 0 or groups_per_program & (groups_per_program - 1):
+        raise ValueError("groups_per_program must be a positive power of two")
+    if reverse_sorted.dtype != torch.int32 or reverse_sorted.numel() < m * topk:
+        raise ValueError("reverse_sorted must have int32 storage for every route")
+
+    scale_cols = h // 32
+    scale_cols_pad = triton.cdiv(scale_cols, 8) * 8
+    capacity = sorted_ids.numel()
+    scale_rows_pad = triton.cdiv(capacity, 32) * 32
+    a1 = torch.empty((m, h), dtype=dtypes.fp8, device=hidden_states.device)
+    sorted_scale = torch.empty(
+        (scale_rows_pad, scale_cols_pad),
+        dtype=dtypes.fp8_e8m0,
+        device=hidden_states.device,
+    )
+    group_tiles = triton.cdiv(scale_cols, groups_per_program)
+    quant_programs = m * group_tiles
+    pad_block = 1024
+    pad_programs = (
+        triton.cdiv(scale_rows_pad * scale_cols_pad, pad_block)
+        if initialize_padding
+        else 0
+    )
+    _token_once_quant_scatter[(quant_programs + pad_programs,)](
+        hidden_states,
+        reverse_sorted,
+        sorted_ids,
+        num_valid_ids,
+        a1,
+        sorted_scale.view(torch.uint8),
+        M=m,
+        H=h,
+        TOPK=topk,
+        STRIDE_M=hidden_states.stride(0),
+        STRIDE_H=hidden_states.stride(1),
+        SCALE_COLS=scale_cols,
+        SCALE_COLS_PAD=scale_cols_pad,
+        SORTED_CAPACITY=capacity,
+        SCALE_ROWS_PAD=scale_rows_pad,
+        GROUPS_PER_PROGRAM=groups_per_program,
+        GROUP_TILES=group_tiles,
+        QUANT_PROGRAMS=quant_programs,
+        INITIALIZE_PADDING=initialize_padding,
+        PAD_BLOCK=pad_block,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return a1, sorted_scale
+
+
+@triton.jit
+def _decode_quant_sort_a1(
+    X,
+    TOPK_IDS,
+    TOPK_WEIGHTS,
+    SORTED_IDS,
+    SORTED_WEIGHTS,
+    SORTED_EXPERTS,
+    NUM_VALID,
+    MOE_OUT,
+    A1,
+    SORTED_SCALE,
+    M: tl.constexpr,
+    H: tl.constexpr,
+    E: tl.constexpr,
+    TOPK: tl.constexpr,
+    BM: tl.constexpr,
+    STRIDE_M: tl.constexpr,
+    STRIDE_H: tl.constexpr,
+    SCALE_COLS: tl.constexpr,
+    SCALE_COLS_PAD: tl.constexpr,
+    GROUPS_PER_PROGRAM: tl.constexpr,
+    GROUP_TILES: tl.constexpr,
+    HIST_BINS: tl.constexpr,
+    ROUTE_BLOCK: tl.constexpr,
+):
+    """Decode-only independently recomputed routes; no inter-CTA dependency."""
+    pid = tl.program_id(0)
+    token = pid // GROUP_TILES
+    group_tile = pid % GROUP_TILES
+    group = group_tile * GROUPS_PER_PROGRAM + tl.arange(0, GROUPS_PER_PROGRAM)
+    feature = group[:, None] * 32 + tl.arange(0, 32)[None, :]
+
+    # Quantize and zero a disjoint feature slice before holding routing state.
+    x = tl.load(
+        X + token * STRIDE_M + feature * STRIDE_H,
+        mask=feature < H,
+        other=0.0,
+    ).to(tl.float32)
+    amax = tl.maximum(tl.max(tl.abs(x), axis=1), 1.0e-10)
+    ratio_bits = (amax * (1.0 / 448.0)).to(tl.uint32, bitcast=True)
+    exponent = (ratio_bits >> 23) & 255
+    exponent += ((exponent < 255) & ((ratio_bits & 0x7FFFFF) != 0)).to(tl.uint32)
+    dequant_scale = (exponent << 23).to(tl.float32, bitcast=True)
+    inverse_scale = tl.inline_asm_elementwise(
+        "v_rcp_f32 $0, $1;",
+        constraints="=v,v",
+        args=[dequant_scale],
+        dtype=tl.float32,
+        is_pure=True,
+        pack=1,
+    )
+    scaled = tl.minimum(tl.maximum(x * inverse_scale[:, None], -448.0), 448.0)
+    tl.store(
+        A1 + token * H + feature,
+        scaled.to(tl.float8e4nv, fp_downcast_rounding="rtne"),
+        mask=feature < H,
+    )
+    tl.store(MOE_OUT + token * H + feature, 0.0, mask=feature < H)
+
+    # Every CTA obtains a private, complete histogram from current IDs.  The
+    # duplicated work avoids reading metadata produced by another workgroup.
+    route_idx = tl.arange(0, ROUTE_BLOCK)
+    route_ids = tl.load(TOPK_IDS + route_idx, mask=route_idx < M * TOPK, other=-1)
+    route_live = (route_idx < M * TOPK) & (route_ids >= 0) & (route_ids < E)
+    histogram_ids = tl.where(route_live, route_ids, HIST_BINS - 1)
+    histogram = tl.histogram(histogram_ids, HIST_BINS)
+    expert_bins = tl.arange(0, HIST_BINS)
+    padded_count = tl.where(expert_bins < E, tl.cdiv(histogram, BM) * BM, 0)
+    expert_begin = tl.cumsum(padded_count, axis=0) - padded_count
+    if pid == 0:
+        tl.store(NUM_VALID, tl.sum(padded_count, axis=0))
+        tl.store(NUM_VALID + 1, M)
+
+    # Gather all six expert prefixes/counts at once instead of reducing each
+    # 512-bin table once per slot.  Rank's route dimension is cooperative;
+    # the slot dimension exposes the six independent comparisons together.
+    slot = tl.arange(0, 8)
+    current_route = token * TOPK + slot
+    expert = tl.load(TOPK_IDS + current_route, mask=slot < TOPK, other=-1)
+    valid_expert = (slot < TOPK) & (expert >= 0) & (expert < E)
+    safe_expert = tl.where(valid_expert, expert, 0)
+    begin = tl.gather(expert_begin, safe_expert, axis=0)
+    count = tl.gather(histogram, safe_expert, axis=0)
+    rank = tl.sum(
+        ((route_idx[None, :] < current_route[:, None])
+         & route_live[None, :]
+         & (route_ids[None, :] == expert[:, None])).to(tl.int32),
+        axis=1,
+    )
+    # Keep vector arithmetic but emit each route with the parent's store
+    # shape.  Only small eight-element vectors need scalar extraction.
+    for route_slot in tl.static_range(TOPK):
+        route_begin = tl.sum(tl.where(slot == route_slot, begin, 0), axis=0)
+        route_count = tl.sum(tl.where(slot == route_slot, count, 0), axis=0)
+        route_rank = tl.sum(tl.where(slot == route_slot, rank, 0), axis=0)
+        route_expert = tl.load(TOPK_IDS + token * TOPK + route_slot)
+        route_valid = (route_expert >= 0) & (route_expert < E)
+        sorted_row = route_begin + route_rank
+        tl.store(
+            SORTED_SCALE + _mx_scale_offset(sorted_row, group, SCALE_COLS_PAD),
+            exponent.to(tl.uint8),
+            mask=route_valid & (group < SCALE_COLS),
+        )
+        if group_tile == 0:
+            route_weight = tl.load(TOPK_WEIGHTS + token * TOPK + route_slot)
+            tl.store(
+                SORTED_IDS + sorted_row,
+                (route_slot << 24) | token,
+                mask=route_valid,
+            )
+            tl.store(SORTED_WEIGHTS + sorted_row, route_weight, mask=route_valid)
+            tl.store(
+                SORTED_EXPERTS + sorted_row // BM,
+                route_expert,
+                mask=route_valid & (route_rank % BM == 0),
+            )
+            pad_lane = tl.arange(0, BM)
+            tail_length = tl.cdiv(route_count, BM) * BM - route_count
+            pad_row = route_begin + route_count + pad_lane
+            tail_owner = route_valid & (route_rank == route_count - 1)
+            pad_mask = tail_owner & (pad_lane < tail_length)
+            tl.store(SORTED_IDS + pad_row, (TOPK << 24) | M, mask=pad_mask)
+            tl.store(SORTED_WEIGHTS + pad_row, 0.0, mask=pad_mask)
+
+
+def quantize_sort_a1(
+    hidden_states,
+    topk_ids,
+    topk_weights,
+    num_experts=384,
+    block_m=32,
+    *,
+    groups_per_program=32,
+):
+    """One preparation launch for the M64 call.
+
+    Returns ``(sorted_ids, sorted_weights, sorted_expert_ids, num_valid_ids,
+    moe_out, a1, sorted_scale)`` in the native interface order.  Sorting is
+    stable over flattened (token, route-slot) order.  All current route IDs
+    contribute to every CTA's private histogram, and no CTA consumes another
+    CTA's writes.  Metadata, route tails and output zeroing have unique owners.
+
+    The memory-capacity bound is the same native distribution-independent
+    allocation, rounded to BM.  ``num_valid_ids[0]`` is the device-computed
+    sum of per-expert padded route counts; element 1 is the token count.
+    Sorted scale padding is left untouched, matching native fused small-M
+    preparation as documented at the top of this file.
+
+    This intentionally duplicates histogram/rank work across feature CTAs.
+    Only a complete admitted evaluation can determine whether eliminating
+    native sorting and separate scale preparation outweighs that work.
+    """
+    m, h = hidden_states.shape
+    if m != 64 or topk_ids.shape != (64, 6) or num_experts != 384:
+        raise ValueError("fused preparation is specialized to M64/E384/topk6")
+    if hidden_states.dtype != dtypes.bf16 or h % 32:
+        raise ValueError("fused preparation expects BF16 rows with H divisible by 32")
+    if not topk_ids.is_contiguous() or not topk_weights.is_contiguous():
+        raise ValueError("fused preparation expects contiguous routing tensors")
+    if topk_ids.dtype != torch.int32 or topk_weights.dtype != torch.float32:
+        raise ValueError("routing tensors must be int32 IDs and float32 weights")
+    if block_m < 16 or block_m & (block_m - 1):
+        raise ValueError("block_m must be a power of two at least 16")
+    if groups_per_program <= 0 or groups_per_program & (groups_per_program - 1):
+        raise ValueError("groups_per_program must be a positive power of two")
+
+    topk = topk_ids.shape[1]
+    capacity = triton.cdiv(m * topk + num_experts * block_m - topk, block_m) * block_m
+    scale_cols = h // 32
+    scale_cols_pad = triton.cdiv(scale_cols, 8) * 8
+    scale_rows_pad = triton.cdiv(capacity, 32) * 32
+    device = hidden_states.device
+    sorted_ids = torch.empty((capacity,), dtype=torch.int32, device=device)
+    sorted_weights = torch.empty((capacity,), dtype=torch.float32, device=device)
+    sorted_experts = torch.empty((capacity // block_m,), dtype=torch.int32, device=device)
+    num_valid = torch.empty((2,), dtype=torch.int32, device=device)
+    moe_out = torch.empty((m, h), dtype=hidden_states.dtype, device=device)
+    a1 = torch.empty((m, h), dtype=dtypes.fp8, device=device)
+    sorted_scale = torch.empty(
+        (scale_rows_pad, scale_cols_pad), dtype=dtypes.fp8_e8m0, device=device
+    )
+    group_tiles = triton.cdiv(scale_cols, groups_per_program)
+    _decode_quant_sort_a1[(m * group_tiles,)](
+        hidden_states,
+        topk_ids,
+        topk_weights,
+        sorted_ids,
+        sorted_weights,
+        sorted_experts,
+        num_valid,
+        moe_out,
+        a1,
+        sorted_scale.view(torch.uint8),
+        M=m,
+        H=h,
+        E=num_experts,
+        TOPK=topk,
+        BM=block_m,
+        STRIDE_M=hidden_states.stride(0),
+        STRIDE_H=hidden_states.stride(1),
+        SCALE_COLS=scale_cols,
+        SCALE_COLS_PAD=scale_cols_pad,
+        GROUPS_PER_PROGRAM=groups_per_program,
+        GROUP_TILES=group_tiles,
+        HIST_BINS=512,
+        ROUTE_BLOCK=512,
+        num_warps=4,
+        enable_fp_fusion=False,
+    )
+    return sorted_ids, sorted_weights, sorted_experts, num_valid, moe_out, a1, sorted_scale

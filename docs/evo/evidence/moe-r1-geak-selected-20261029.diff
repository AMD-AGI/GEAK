+# SPDX-License-Identifier: MIT
+"""Decode-only BM16 expert GEMMs, using native packed weight/scale interfaces."""
+
+from dataclasses import replace
+from functools import partial
+
+from aiter import dtypes
+from aiter.fused_moe import (
+    ActivationType,
+    QuantType,
+    _fused_moe_impl,
+    _flydsl_stage1_wrapper,
+)
+from aiter.ops.opus.moe_stage2_a8w4 import (
+    opus_a8w4_stage2_wrapper,
+    stage2_launch_config,
+)
+
+
+_STAGE1 = "flydsl_moe1_afp8_wfp4_bf16_t16x128x256_w3_gui_fp8"
+_STAGE2 = "opus_moe2_afp8_wfp4_atomic_t16x128x256_sbm16_cache_b3_ws2"
+_STAGE2_ID = 2008
+
+# Unrecognized public options retain upstream dispatch and validation.
+_OPTIONS = frozenset((
+    "activation", "quant_type", "doweight_stage1", "gate_mode",
+    "hidden_pad", "intermediate_pad", "swiglu_limit", "w1_scale", "w2_scale",
+    "a1_scale", "a2_scale", "block_size_M",
+))
+
+
+def supports_decode(hidden_states, w1, w2, topk_weight, topk_ids, options):
+    if not options.keys() <= _OPTIONS:
+        return False
+    return (
+        tuple(hidden_states.shape) == (64, 7168)
+        and tuple(w1.shape) == (384, 768, 3584)
+        and tuple(w2.shape) == (384, 7168, 192)
+        and tuple(topk_ids.shape) == (64, 6)
+        and tuple(topk_weight.shape) == (64, 6)
+        and hidden_states.dtype == dtypes.bf16
+        and w1.dtype == dtypes.fp4x2 and w2.dtype == dtypes.fp4x2
+        and getattr(w1, "is_shuffled", False) is True
+        and getattr(w2, "is_shuffled", False) is True
+        and getattr(w1, "gate_up_interleave", None) in (None, True)
+        and getattr(w2, "gate_up_interleave", None) in (None, False)
+        and options.get("activation") == ActivationType.Silu
+        and options.get("quant_type") == QuantType.per_1x32
+        and options.get("gate_mode") == "interleave"
+        and options.get("swiglu_limit") == 10.0
+        and not options.get("doweight_stage1", False)
+        and options.get("hidden_pad", 0) == 0
+        and options.get("intermediate_pad", 0) == 0
+        and options.get("a1_scale") is None
+        and options.get("a2_scale") is None
+        and options.get("block_size_M") in (None, -1)
+        and options.get("w1_scale") is not None
+        and options.get("w2_scale") is not None
+    )
+
+
+def decode_metadata(metadata):
+    """Return private metadata; never modify a cached upstream partial."""
+    stage1_kw = dict(metadata.stage1.keywords)
+    stage1_kw["kernelName"] = _STAGE1
+    stage2_kw = dict(metadata.stage2.keywords)
+    stage2_kw.update(kernelName=_STAGE2, launch=stage2_launch_config(_STAGE2_ID))
+    # Sorting and both GEMMs agree on BM16. Native A1 and fused A2 quantizers
+    # retain the regular 32-row packed scale layout. Opus selects the proper
+    # 16-row half and handles all 12 logical I/32 groups in 16-column storage.
+    return replace(
+        metadata,
+        block_m=16,
+        stage1=partial(_flydsl_stage1_wrapper, *metadata.stage1.args, **stage1_kw),
+        stage2=partial(opus_a8w4_stage2_wrapper, *metadata.stage2.args, **stage2_kw),
+        fuse_quant="fp8",
+    )
+
+
+def fused_decode(hidden_states, w1, w2, topk_weight, topk_ids, **options):
+    call_options = dict(options)
+    for key in ("activation", "quant_type"):
+        value = call_options[key]
+        call_options[key] = getattr(value, "value", value)
+    return _fused_moe_impl(
+        hidden_states, w1, w2, topk_weight, topk_ids,
+        _metadata_transform=decode_metadata, **call_options
+    )
+

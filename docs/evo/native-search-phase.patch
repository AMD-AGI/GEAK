+    def _search_bounds(self):
+        template = self.templates["admission"]
+        phase = template.get("search_phase_deadline_seconds")
+        seconds = self.clock["wall_seconds"]
+        if not {"search_phase_deadline_seconds", "search_deadline_seconds"}.intersection(template):
+            return None, seconds
+        inherited = template.get("phase_deadline_seconds")
+        need(type(inherited) in (int, float) and math.isfinite(inherited) and inherited > 0,
+             "search phase requires a positive finite inherited phase deadline")
+        if "search_phase_deadline_seconds" in template:
+            need(type(phase) in (int, float) and 0 < phase <= inherited and math.isfinite(phase),
+                 "search phase must be positive, finite, and within the inherited phase deadline")
+        if "search_deadline_seconds" in template:
+            seconds = template["search_deadline_seconds"]
+            need(type(seconds) in (int, float) and 0 < seconds <= min(inherited, self.clock["wall_seconds"])
+                 and math.isfinite(seconds), "search deadline must be positive, finite, and within the phase/original clock")
+            need(phase is not None and phase <= seconds, "native search phase must fit the search deadline")
+        return phase, seconds
+
+    def _campaign_deadline(self):
+        return self.clock["started_unix"] + self._search_bounds()[1]


# Template for the runner's credential / gateway configuration.
#
# Copy it to a path **outside the repository** (e.g. ~/.config/workload/claude.env), fill
# it in, and point the scenario config at it:
#
#     "runner_env": { "env_file": "/home/<you>/.config/workload/claude.env" }
#
# Never commit a filled-in copy — it contains a subscription key.
# The runner does `set -a; . <file>; set +a`, so plain shell assignments are all that is
# needed here.

# ---- Talking to the Anthropic API directly needs only this line.
# ANTHROPIC_API_KEY=sk-ant-...

# ---- Going through a corporate gateway (which is how this cluster works) needs these.
# ANTHROPIC_BASE_URL=https://<gateway-host>/<path>
# ANTHROPIC_AUTH_TOKEN=x
# ANTHROPIC_CUSTOM_HEADERS='Ocp-Apim-Subscription-Key: <your subscription key>
# user: <your username>'
#
# Note that ANTHROPIC_CUSTOM_HEADERS is **multi-line**, one header per line.

# ---- Model.
# Do not export ANTHROPIC_MODEL elsewhere — some clusters export it from .bashrc, and a
# `${VAR:-default}` idiom then silently runs a different model. Set it here, or use
# WORKLOAD_AGENT_MODEL.
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-5
# ANTHROPIC_DEFAULT_SONNET_MODEL=claude-opus-5
# ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-opus-5
# CLAUDE_CODE_SUBAGENT_MODEL=claude-opus-5

# ---- Two settings long runs cannot do without.
# A single attempt runs far longer than 600 s; without this line background tasks are
# killed at 600 s.
CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0
# The default timeout is not enough when gateway latency is high.
API_TIMEOUT_MS=600000

# ---- Only needed for a self-signed gateway. Leave it off if you can.
# NODE_TLS_REJECT_UNAUTHORIZED=0

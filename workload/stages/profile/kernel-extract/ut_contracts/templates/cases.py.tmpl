"""Seeded case factory for task `{task_name}` (UT contract family `{family}`).

Generated by ut_contracts/scaffold_ut.py. Operands come from run/ut_contract.json through
ut_contract.build_inputs, so shapes, dtypes, value distributions and stored layouts are the
contract's, not this file's. What remains task-specific is marked FILL:

  * HOOKS     — the family's hooks (quantizers, layout transforms, structural metadata); each
                stub raises until written from the installed stack.
  * call()    — invoke the live entry exactly as the deployed caller does.
  * replay_bundle() — only for phases that deploy under a CUDA graph.

Entry under test: `{target_callable}`. Record its live call site here (file, line, the exact
call) once inspected; the UT is wrong if the signature here is a guess.
"""
import importlib
import importlib.util
import json
import os
import sys

import torch

_HERE = os.path.dirname(os.path.abspath(__file__))


def _load(name):
    path = os.path.join(_HERE, name + ".py")
    mod = sys.modules.get(name)
    if mod is not None and getattr(mod, "__file__", None) == path:
        return mod
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


U = _load("ut_contract")
CONTRACT = U.load_task_contract(_HERE)
with open(os.path.join(_HERE, "run", "ut_cases.json")) as _fh:
    MANIFEST = json.load(_fh)
TARGET = {target_callable!r}

# ----------------------------------------------------------------------------- FILL: hooks
{hook_stubs}
HOOKS = {{{hook_map}}}

# ----------------------------------------------------------------------------- FILL: call
_ENTRY = None


def _entry():
    """Resolve the declared entry through the ambient overlay, once."""
    global _ENTRY
    if _ENTRY is None:
        mod, _, attr = TARGET.partition(":")
        obj = importlib.import_module(mod)
        for part in attr.split("."):
            obj = getattr(obj, part)
        _ENTRY = obj
    return _ENTRY


def call(args):
    """Invoke the live entry and return every output, in contract order: {outputs}.

    Pass operands under the inspected signature's names; keys starting with `_` are bookkeeping
    and never reach the kernel. {call_note}"""
    raise NotImplementedError("FILL call(): bind {target_callable} with the deployed caller's "
                              "arguments and return ({outputs})")


# ----------------------------------------------------------------------------- generic machinery
def _device():
    return "cuda" if torch.cuda.is_available() else "cpu"


def case_seed(c):
    """Deterministic per-signature seed, frozen with the manifest."""
    return int(c.get("seed", 1000 + sum(ord(ch) * (i + 1) for i, ch in enumerate(c["sig"]))))


def make_args(spec, gen=None, seed=None, with_logical=False):
    """Realise one manifest row. Construction is OUTSIDE any timed region; the same generator
    state yields the same operands in every process, with or without the float64 copies."""
    device = _device()
    if gen is None:
        gen = torch.Generator(device=device).manual_seed(case_seed(spec) if seed is None else int(seed))
    args, logical, sym = U.build_inputs(CONTRACT, spec.get("axes") or {{}}, gen, device, HOOKS,
                                        with_logical=with_logical)
    args["_sig"] = spec["sig"]
    args["_sym"] = sym
    if with_logical:
        args["_logical"] = logical
    return args


def manifest_cases(**filt):
    for c in MANIFEST["cases"]:
        if all(c.get(k) == v for k, v in filt.items()):
            yield c


def _argv_opt(flag):
    argv = sys.argv
    if flag in argv:
        i = argv.index(flag)
        return argv[i + 1] if i + 1 < len(argv) else None
    for a in argv:
        if a.startswith(flag + "="):
            return a.split("=", 1)[1]
    return None


def timing_cases(h, meta):
    """Timed rows. leg_runner filters by --bucket AFTER calling this, so build only the requested
    bucket's operands, and none for --mode list: same rows, a fraction of the allocation."""
    mode, bucket = _argv_opt("--mode"), _argv_opt("--bucket")
    rows = list(manifest_cases(timed=True))
    if mode == "list":
        return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"), "args": None}} for c in rows]
    if bucket:
        rows = [c for c in rows if c["sig"] == bucket]
    return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"), "args": make_args(c)}}
            for c in rows]


def random_shapes(h, meta):
    """Value-parity cases: the factory takes the leg's seeded generator."""
    return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"),
             "make_inputs": (lambda spec: (lambda rng: make_args(spec, gen=rng)))(c)}}
            for c in manifest_cases(random=True)]


def eager_cases(h, meta):
    return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"), "args": make_args(c)}}
            for c in manifest_cases(random=True)]


def replay_bundle(h, meta, phase):
    """FILL for a phase that deploys under a CUDA graph; return None otherwise.

    Return {{"fill": fn(case), "run": fn(), "read_out": fn() -> outputs, "cases": [...],
    "capture_idx": i, "valid": optional fn(case, out) -> the case's region of a padded output}}.
    Allocate static buffers once at the largest replay case (capture_idx); `fill` copies a case's
    operands into them (never reallocates); `run` is one graph-safe launch; cases are the manifest's
    replay_sigs for this phase, built with make_args(c, with_logical=True) so the replay compare
    can use the float64 reference."""
    return None

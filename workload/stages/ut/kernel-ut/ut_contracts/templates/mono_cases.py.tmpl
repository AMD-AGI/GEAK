{oracle_defs}
ORACLES = {{{oracle_map}}}


# ----------------------------------------------------------------------------- generic machinery
def _device():
    return "cuda" if torch.cuda.is_available() else "cpu"


def case_seed(c):
    """Deterministic per-signature seed, frozen with the manifest."""
    return int(c.get("seed", 1000 + sum(ord(ch) * (i + 1) for i, ch in enumerate(c["sig"]))))


def make_args(spec, gen=None, seed=None, with_logical=False):
    """Realise one manifest row. Construction is OUTSIDE any timed region; the same generator
    state yields the same operands in every process, with or without the float64 copies."""
    device = _device()
    if gen is None:
        gen = torch.Generator(device=device).manual_seed(case_seed(spec) if seed is None else int(seed))
    args, logical, sym = U.build_inputs(CONTRACT, spec.get("axes") or {{}}, gen, device, HOOKS,
                                        with_logical=with_logical, weight_cache=_WEIGHTS)
    args["_sig"] = spec["sig"]
    args["_sym"] = sym
    if with_logical:
        args["_logical"] = logical
    return args


def manifest_cases(**filt):
    for c in MANIFEST["cases"]:
        if all(c.get(k) == v for k, v in filt.items()):
            yield c


def _argv_opt(flag):
    argv = sys.argv
    if flag in argv:
        i = argv.index(flag)
        return argv[i + 1] if i + 1 < len(argv) else None
    for a in argv:
        if a.startswith(flag + "="):
            return a.split("=", 1)[1]
    return None


def timing_cases(h, meta):
    """Timed rows. leg_runner filters by --bucket AFTER calling this, so build only the requested
    bucket's operands, and none for --mode list: same rows, a fraction of the allocation."""
    mode, bucket = _argv_opt("--mode"), _argv_opt("--bucket")
    rows = list(manifest_cases(timed=True))
    if mode == "list":
        return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"), "args": None}} for c in rows]
    if bucket:
        rows = [c for c in rows if c["sig"] == bucket]
    return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"), "args": make_args(c)}}
            for c in rows]


def random_shapes(h, meta):
    """Value-parity cases: the factory takes the leg's seeded generator."""
    return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"),
             "make_inputs": (lambda spec: (lambda rng: make_args(spec, gen=rng)))(c)}}
            for c in manifest_cases(random=True)]


def eager_cases(h, meta):
    return [{{"sig": c["sig"], "regime": c["regime"], "m": c.get("m"), "args": make_args(c)}}
            for c in manifest_cases(random=True)]


GRAPH_PHASES = {graph_phases!r}


def replay_bundle(h, meta, phase):
    """The phases that deploy under a CUDA graph (GRAPH_PHASES). Static buffers are allocated
    once at the capture case (the longest context, so the page table width covers every replay
    case); the helpers mirror every fill and replay their own graph right after it, and the
    driver's replay of rank 0's graph pairs with them through the in-kernel exchanges. The
    replay sigs share one row count (a graph is per width). `interleave` (DESIGN 1.5) is the
    replay gate's extra case: one runner, small graph -> large graph -> small eager -> large
    graph -> small graph back to back, every step against an eager reference computed before
    the sequence on state no graph had touched."""
    if phase not in GRAPH_PHASES:
        return None
    rows = [c for c in MANIFEST["cases"] if c["sig"] in MANIFEST.get("replay_sigs", []) and c["regime"] == phase]
    if len(rows) < 2:
        return None
    R = _harness()
    cases = [{{"sig": c["sig"], "regime": c["regime"], "args": make_args(c, with_logical=True)}} for c in rows]
    width = max(R.Model.page_width(int(c["args"]["_sym"]["context"])) for c in cases)
    capture_idx = max(range(len(cases)), key=lambda i: int(cases[i]["args"]["_sym"]["context"]))
    state = {{}}

    def fill(case):
        if "rep" not in state:
            state["rep"] = R.Replay(width)
        a = case["args"]
        state["rep"].fill(int(a["_sym"]["rows"]), int(a["_sym"]["context"]), a["stream"], a["attn_input"],
                          a.get("stream_aux"))

    def run():
        state["rep"].run()

    def read_out():
        dev = cases[0]["args"]["stream"].device
        return {{k: v.to(dev) for k, v in state["rep"].read().items()}}

    bundle = {{"fill": fill, "run": run, "read_out": read_out, "cases": cases, "capture_idx": capture_idx}}
    by_rows = {{}}
    for c in manifest_cases(random=True, regime=phase):
        by_rows.setdefault(int(c["axes"]["rows"]), set()).add(int(c["axes"]["context"]))
    if len(by_rows) >= 2:
        small, large = min(by_rows), max(by_rows)
        bundle["interleave"] = lambda: R.run_interleave(R.interleave_plan(
            sorted(by_rows[small]), sorted(by_rows[large]), small_rows=small, large_rows=large))
    return bundle


# ----------------------------------------------------------------------------- rank_chain
CHAIN_LENGTH = {chain_length}


def rank_chain(rank, world, group, case):
    """Timing (meta.timing.kind rank_chain, shared/rank_timing.py): rank_harness.Chain, a chain of
    CHAIN_LENGTH launches over distinct layers at the case's rows and context, with the case's
    own operands (make_args); its first check() runs the call() path once on the same case and
    compares (DESIGN 6.1)."""
    return _harness().Chain(rank, world, group, case, make_args(case), CHAIN_LENGTH)

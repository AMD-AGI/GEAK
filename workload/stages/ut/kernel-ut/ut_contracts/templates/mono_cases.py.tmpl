"""Seeded case factory for task `{task_name}` (UT contract family `{family}`, a multi-rank
monokernel layer). Generated by ut_contracts/scaffold_ut.py.

call(), the oracle legs, the graph-replay bundle and rank_chain timing all run the WORLD ranks
through rank_harness.py (generic, frozen task source outside the candidate overlay); everything
model-specific is rank_model.py's RankModel -- that is the file to fill, not this one. This file
only turns manifest rows into operands and hands them to the harness.

FILL: the live call site of `{target_callable}` (file, line, the exact call, every rank's call
order within a step), copied here once inspected (references/mono-layer-ut.md section 1).
"""
import importlib
import importlib.util
import json
import os
import sys

import torch

_HERE = os.path.dirname(os.path.abspath(__file__))


def _load(name):
    path = os.path.join(_HERE, name + ".py")
    mod = sys.modules.get(name)
    if mod is not None and getattr(mod, "__file__", None) == path:
        return mod
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec)
    sys.modules[name] = mod
    spec.loader.exec_module(mod)
    return mod


U = _load("ut_contract")
CONTRACT = U.load_task_contract(_HERE)
_GENERATION = CONTRACT.get("input_generation") or {{}}
_WEIGHTS = (U.WeightCache(_GENERATION.get("weight_cache_bytes", 2 << 30))
            if _GENERATION.get("protocol") == "weight_substreams/v1" else None)
with open(os.path.join(_HERE, "run", "ut_cases.json")) as _fh:
    MANIFEST = json.load(_fh)
TARGET = {target_callable!r}
HOOKS = {{}}
_ENTRY = None


def _entry():
    """Resolve the declared entry through the ambient overlay, once (binding evidence)."""
    global _ENTRY
    if _ENTRY is None:
        mod, _, attr = TARGET.partition(":")
        obj = importlib.import_module(mod)
        for part in attr.split("."):
            obj = getattr(obj, part)
        _ENTRY = obj
    return _ENTRY


def _harness():
    """rank_harness.py, frozen task source outside the candidate overlay: it imports the entry
    through the ambient overlay in every rank process."""
    return _load("rank_harness")


def _step(args, path):
    sym = args["_sym"]
    _entry()
    return _harness().call_ranks(int(sym["rows"]), int(sym["context"]), args["stream"], args["attn_input"], path,
                                 aux=args.get("stream_aux"))


def call(args):
    """One step of the deployed path (RankModel.PATHS[0]) on every rank: a dict of every contract
    output ({outputs}), each [world, ...], plus report-only diag_*. Host setup (page tables,
    poisoning, cache save / restore, gathering) is inside call(): it is never what is timed."""
    return _step(args, _harness().DEPLOYED)


